<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VaultJ Coin Exchange</title>
  <style>
    * { box-sizing: border-box; }
    body {
      background: #0b0e14;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
      margin: 0;
      padding: 0;
      color: #eaecef;
    }
    a { color: inherit; }

    .status-banner {
      max-width: 1400px;
      margin: 16px auto 0;
      padding: 12px 18px;
      border-radius: 6px;
      font-weight: bold;
    }
    .status-error { background: #2b1414; color: #ff6b6b; border: 1px solid #a10000; }
    .status-success { background: #0f2a1a; color: #4ade80; border: 1px solid #1a7a2e; }

    /* ---- Top ticker bar ---- */
    .topbar {
      background: #12161f;
      border-bottom: 1px solid #1f2430;
      padding: 14px 24px;
    }
    .topbar-inner {
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 28px;
      flex-wrap: wrap;
    }
    .coin-id { display: flex; align-items: center; gap: 10px; }
    .coin-id img {
      width: 36px; height: 36px; border-radius: 50%;
      border: 2px solid #f0b90b; object-fit: cover;
    }
    .coin-id .name { font-size: 16px; font-weight: 700; color: #fff; }
    .coin-id .ticker { font-size: 11px; color: #848e9c; }

    .tb-stat { display: flex; flex-direction: column; gap: 2px; }
    .tb-stat .label { font-size: 10px; color: #848e9c; text-transform: uppercase; letter-spacing: 0.4px; }
    .tb-stat .val { font-size: 14px; font-weight: 600; color: #eaecef; }
    .tb-stat .val.price { font-size: 20px; color: #f0b90b; }
    .tb-stat .val.up { color: #0ecb81; }
    .tb-stat .val.down { color: #f6465d; }

    /* ---- Layout grid ---- */
    .layout {
      max-width: 1400px;
      margin: 20px auto;
      padding: 0 20px;
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 20px;
      align-items: start;
    }

    /* ---- Chart card ---- */
    .chart-card {
      background: #12161f;
      border: 1px solid #1f2430;
      border-radius: 10px;
      overflow: hidden;
    }
    .chart-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 18px;
      border-bottom: 1px solid #1f2430;
      flex-wrap: wrap;
      gap: 10px;
    }
    .tf-tabs { display: flex; gap: 4px; background: #0b0e14; border-radius: 8px; padding: 4px; }
    .tf-tab {
      border: none;
      background: transparent;
      color: #848e9c;
      font-size: 12px;
      font-weight: 600;
      padding: 6px 12px;
      border-radius: 6px;
      cursor: pointer;
    }
    .tf-tab.active { background: #f0b90b; color: #0b0e14; }
    .tf-tab:hover:not(.active) { color: #eaecef; }

    .range-readout { font-size: 12px; color: #848e9c; }
    .range-readout span { color: #eaecef; font-weight: 600; }

    .chart-wrap { padding: 14px 18px 6px; position: relative; }
    #priceChart { width: 100%; height: 320px; display: block; }
    .chart-empty { text-align: center; color: #848e9c; padding: 60px 0; font-size: 13px; }

    .chart-stats-row {
      display: flex;
      border-top: 1px solid #1f2430;
    }
    .cs-cell {
      flex: 1;
      padding: 12px 18px;
      border-right: 1px solid #1f2430;
    }
    .cs-cell:last-child { border-right: none; }
    .cs-cell .label { font-size: 10px; color: #848e9c; text-transform: uppercase; }
    .cs-cell .val { font-size: 13px; font-weight: 700; margin-top: 3px; }
    .cs-cell .val.green { color: #0ecb81; }
    .cs-cell .val.red { color: #f6465d; }
    .cs-cell .val.gold { color: #f0b90b; }

    /* ---- Trade panel (right column, sticky) ---- */
    .trade-panel {
      background: #12161f;
      border: 1px solid #1f2430;
      border-radius: 10px;
      overflow: hidden;
      position: sticky;
      top: 20px;
    }
    .trade-tabs { display: flex; border-bottom: 1px solid #1f2430; }
    .trade-tab {
      flex: 1;
      background: none;
      border: none;
      padding: 14px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      color: #848e9c;
      border-bottom: 2px solid transparent;
    }
    .trade-tab.buy.active { color: #0ecb81; border-bottom-color: #0ecb81; }
    .trade-tab.sell.active { color: #f6465d; border-bottom-color: #f6465d; }

    .trade-body { padding: 18px; display: none; }
    .trade-body.active { display: block; }

    .balance-mini {
      display: flex;
      justify-content: space-between;
      background: #0b0e14;
      border: 1px solid #1f2430;
      border-radius: 8px;
      padding: 12px 14px;
      margin-bottom: 16px;
      font-size: 12px;
    }
    .balance-mini .bm-block .label { color: #848e9c; font-size: 10px; text-transform: uppercase; }
    .balance-mini .bm-block .value { font-size: 14px; font-weight: 700; color: #fff; margin-top: 2px; }
    .balance-mini .bm-block.coin .value { color: #f0b90b; }

    .field-label {
      font-size: 11px;
      color: #848e9c;
      text-transform: uppercase;
      margin: 12px 0 6px;
      display: flex;
      justify-content: space-between;
    }
    .field-label .max-link { color: #f0b90b; cursor: pointer; font-weight: 600; }

    .amount-input-wrap {
      display: flex;
      align-items: center;
      background: #0b0e14;
      border: 1px solid #2b3139;
      border-radius: 8px;
      padding: 10px 12px;
    }
    .amount-input-wrap input {
      flex: 1;
      background: transparent;
      border: none;
      outline: none;
      color: #fff;
      font-size: 16px;
      min-width: 0;
    }
    .amount-input-wrap .unit { color: #848e9c; font-size: 13px; font-weight: 600; }
    .amount-input-wrap:focus-within { border-color: #f0b90b; }

    .swap-icon {
      display: flex;
      justify-content: center;
      margin: 4px 0;
      color: #848e9c;
      font-size: 14px;
    }

    .rate-row {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: #848e9c;
      margin-top: 14px;
      padding-top: 12px;
      border-top: 1px dashed #1f2430;
    }
    .rate-row .rv { color: #eaecef; font-weight: 600; }
    .rate-row + .rate-row { margin-top: 6px; padding-top: 0; border-top: none; }

    .trade-submit-btn {
      width: 100%;
      margin-top: 16px;
      padding: 14px;
      border: none;
      border-radius: 8px;
      font-weight: 700;
      font-size: 15px;
      cursor: pointer;
    }
    .trade-submit-btn.buy { background: #0ecb81; color: #05130c; }
    .trade-submit-btn.sell { background: #f6465d; color: #1a0508; }
    .trade-submit-btn:hover { filter: brightness(1.08); }
    .trade-hint { font-size: 11px; color: #848e9c; margin-top: 10px; text-align: center; line-height: 1.5; }

    /* ---- Admin price box ---- */
    .admin-box {
      max-width: 1400px;
      margin: 0 auto 20px;
      padding: 0 20px;
    }
    .admin-box-inner {
      background: #1c1508;
      border: 1px dashed #f0b90b;
      border-radius: 8px;
      padding: 14px 18px;
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
    }
    .admin-box-inner strong { color: #f0b90b; }
    .admin-box-inner input {
      padding: 8px 10px;
      border: 1px solid #2b3139;
      background: #0b0e14;
      color: #fff;
      border-radius: 6px;
      width: 120px;
    }
    .admin-box-inner button {
      background: #f0b90b;
      color: #0b0e14;
      border: none;
      padding: 9px 16px;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
    }

    /* ---- Sections below grid ---- */
    .section {
      max-width: 1400px;
      margin: 24px auto;
      padding: 0 20px;
    }
    .section h2 {
      color: #fff;
      font-size: 16px;
      border-left: 3px solid #f0b90b;
      padding-left: 10px;
      margin-bottom: 12px;
    }

    .order-table-wrap {
      background: #12161f;
      border: 1px solid #1f2430;
      border-radius: 10px;
      overflow: hidden;
    }
    table.order-book { width: 100%; border-collapse: collapse; }
    table.order-book th {
      background: #0b0e14;
      color: #848e9c;
      text-align: left;
      padding: 12px 14px;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      border-bottom: 1px solid #1f2430;
    }
    table.order-book td {
      padding: 12px 14px;
      border-top: 1px solid #1f2430;
      font-size: 13px;
      color: #eaecef;
    }
    table.order-book tr:hover { background: #171c27; }

    .badge {
      display: inline-block;
      padding: 3px 9px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: bold;
    }
    .badge-active { background: #0f2a1a; color: #0ecb81; }
    .badge-partial { background: #2a2308; color: #f0b90b; }
    .badge-warning { background: #2b1414; color: #f6465d; }

    .price-cell.up { color: #0ecb81; font-weight: bold; }
    .price-cell.down { color: #f6465d; font-weight: bold; }

    .buy-row-btn {
      background: #0ecb81;
      color: #05130c;
      border: none;
      padding: 7px 14px;
      border-radius: 6px;
      font-weight: bold;
      font-size: 12px;
      cursor: pointer;
    }
    .buy-row-btn:hover { filter: brightness(1.1); }

    .cancel-row-btn {
      background: #f6465d;
      color: #1a0508;
      border: none;
      padding: 7px 14px;
      border-radius: 6px;
      font-weight: bold;
      font-size: 12px;
      cursor: pointer;
    }
    .cancel-row-btn:hover { filter: brightness(1.1); }

    .empty-state { padding: 30px; text-align: center; color: #848e9c; font-size: 13px; }

    .trade-item {
      display: flex;
      justify-content: space-between;
      background: #12161f;
      border: 1px solid #1f2430;
      padding: 10px 16px;
      border-radius: 8px;
      margin-bottom: 8px;
      font-size: 13px;
      border-left: 3px solid #848e9c;
    }
    .trade-item.as-buyer { border-left-color: #0ecb81; }
    .trade-item.as-seller { border-left-color: #f6465d; }
    .trade-item .t-main { color: #fff; font-weight: bold; }
    .trade-item .t-sub { color: #848e9c; font-size: 11px; }

    /* ---- Modal (kept for per-seller buy from order book) ---- */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.7);
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 15px;
    }
    .modal-overlay.open { display: flex; }
    .modal-box {
      background: #12161f;
      border: 1px solid #1f2430;
      border-radius: 12px;
      width: 100%;
      max-width: 400px;
      overflow: hidden;
      box-shadow: 0 10px 40px rgba(0,0,0,0.6);
    }
    .modal-header {
      background: #0b0e14;
      color: #f0b90b;
      padding: 16px 20px;
      font-size: 16px;
      font-weight: bold;
      border-bottom: 1px solid #1f2430;
    }
    .modal-body { padding: 18px; color: #cdd3dc; line-height: 1.6; font-size: 13px; }
    .modal-body label { display: block; font-size: 11px; color: #848e9c; text-transform: uppercase; margin: 10px 0 4px; }
    .modal-body input[type="number"] {
      width: 100%; padding: 10px 12px; border: 1px solid #2b3139;
      background: #0b0e14; color: #fff; border-radius: 6px; font-size: 14px;
    }
    .modal-summary { background: #0b0e14; border: 1px solid #1f2430; border-radius: 8px; padding: 10px 14px; margin-top: 12px; font-size: 12px; }
    .modal-summary div { display: flex; justify-content: space-between; margin: 4px 0; }
    .modal-summary .green { color: #0ecb81; font-weight: bold; }
    .modal-summary .red { color: #f6465d; font-weight: bold; }
    .modal-actions { display: flex; border-top: 1px solid #1f2430; }
    .modal-actions button { flex: 1; padding: 13px; border: none; font-weight: bold; font-size: 14px; cursor: pointer; }
    .modal-cancel { background: #1c2129; color: #cdd3dc; }
    .modal-cancel:hover { background: #232a35; }
    .modal-confirm { background: #0ecb81; color: #05130c; }
    .modal-confirm:hover { filter: brightness(1.1); }

    @media (max-width: 960px) {
      .layout { grid-template-columns: 1fr; }
      .trade-panel { position: static; }
    }
    @media (max-width: 600px) {
      .topbar-inner { gap: 16px; }
      table.order-book { font-size: 11px; }
      table.order-book th, table.order-book td { padding: 8px 8px; }
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <% if (error) { %>
    <div class="status-banner status-error"><%= error %></div>
  <% } %>
  <% if (success) { %>
    <div class="status-banner status-success"><%= success %></div>
  <% } %>

  <!-- Top ticker bar -->
  <div class="topbar">
    <div class="topbar-inner">
      <div class="coin-id">
        <img src="/images/logocoin2.png" alt="VaultJ Coin">
        <div>
          <div class="name">VaultJ Coin</div>
          <div class="ticker">VJC / KSH</div>
        </div>
      </div>
      <div class="tb-stat">
        <div class="label">Price</div>
        <div class="val price">Ksh <%= market.currentPrice %></div>
      </div>
      <div class="tb-stat">
        <div class="label">24h/All Change</div>
        <div class="val <%= priceDirection === 'down' ? 'down' : 'up' %>">
          <% if (priceDirection === 'up') { %>&#9650; +<%= changePct %>%<% } %>
          <% if (priceDirection === 'down') { %>&#9660; <%= changePct %>%<% } %>
          <% if (priceDirection === 'flat') { %>&#9679; 0.00%<% } %>
        </div>
      </div>
      <div class="tb-stat">
        <div class="label">High</div>
        <div class="val up">Ksh <%= high %></div>
      </div>
      <div class="tb-stat">
        <div class="label">Low</div>
        <div class="val down">Ksh <%= low %></div>
      </div>
      <div class="tb-stat">
        <div class="label">Coin Balance</div>
        <div class="val gold" style="color:#f0b90b;"><%= user.coinBalance %> VJC</div>
      </div>
      <div class="tb-stat">
        <div class="label">Wallet Balance</div>
        <div class="val">Ksh <%= user.walletBalance %></div>
      </div>
    </div>
  </div>

  <% if (user.isAdmin) { %>
  <div class="admin-box">
    <div class="admin-box-inner">
      <strong>Admin:</strong> Set market price
      <form action="/vault-coin/admin/price" method="POST" style="display:flex; gap:8px; align-items:center;">
        <input type="number" step="0.01" min="0.01" name="price" placeholder="Ksh" required>
        <button type="submit">Update Price</button>
      </form>
    </div>
  </div>
  <% } %>

  <!-- Main grid: chart + trade panel -->
  <div class="layout">
    <!-- Chart card -->
    <div class="chart-card">
      <div class="chart-toolbar">
        <div class="tf-tabs">
          <button class="tf-tab active" data-range="1D">1D</button>
          <button class="tf-tab" data-range="7D">7D</button>
          <button class="tf-tab" data-range="1M">1M</button>
          <button class="tf-tab" data-range="3M">3M</button>
          <button class="tf-tab" data-range="ALL">All</button>
        </div>
        <div class="range-readout">Showing <span id="rangeLabel">Today</span></div>
      </div>
      <div class="chart-wrap">
        <canvas id="priceChart"></canvas>
        <div class="chart-empty" id="chartEmptyMsg" style="display:none;">Not enough price history yet for this range.</div>
      </div>
      <div class="chart-stats-row">
        <div class="cs-cell">
          <div class="label">Range High</div>
          <div class="val green" id="rangeHigh">Ksh <%= high %></div>
        </div>
        <div class="cs-cell">
          <div class="label">Range Low</div>
          <div class="val red" id="rangeLow">Ksh <%= low %></div>
        </div>
        <div class="cs-cell">
          <div class="label">Range Change</div>
          <div class="val <%= priceDirection === 'down' ? 'red' : 'green' %>" id="rangeChange"><%= changePct %>%</div>
        </div>
        <div class="cs-cell">
          <div class="label">Open Listings</div>
          <div class="val gold"><%= openOrders.length %></div>
        </div>
      </div>
    </div>

    <!-- Trade panel -->
    <div class="trade-panel">
      <div class="trade-tabs">
        <button type="button" class="trade-tab buy active" onclick="switchTradeTab('buy')">Buy VJC</button>
        <button type="button" class="trade-tab sell" onclick="switchTradeTab('sell')">Sell VJC</button>
      </div>

      <!-- Buy tab -->
      <div class="trade-body active" id="buyTabBody">
        <div class="balance-mini">
          <div class="bm-block">
            <div class="label">Wallet</div>
            <div class="value">Ksh <%= user.walletBalance %></div>
          </div>
          <div class="bm-block coin">
            <div class="label">Coins Held</div>
            <div class="value"><%= user.coinBalance %> VJC</div>
          </div>
        </div>

        <div class="field-label">You Buy</div>
        <div class="amount-input-wrap">
          <input type="number" id="quickBuyAmount" step="0.01" min="0.01" placeholder="0.00" oninput="updateQuickBuy()">
          <span class="unit">VJC</span>
        </div>

        <div class="swap-icon">&#8595;</div>

        <div class="field-label">You Spend (est.)</div>
        <div class="amount-input-wrap">
          <input type="text" id="quickBuySpend" value="0.00" readonly>
          <span class="unit">KSH</span>
        </div>

        <div class="rate-row"><span>Live rate</span><span class="rv">Ksh <%= market.currentPrice %> / VJC</span></div>
        <div class="rate-row"><span>After 5% fee you receive</span><span class="rv" id="quickBuyReceive">0.00 VJC</span></div>

        <button type="button" class="trade-submit-btn buy" onclick="submitQuickBuy()">Buy VJC</button>
        <div class="trade-hint">Matched against the lowest-priced open sell order(s) below. Large orders may need to be split across multiple sellers.</div>
      </div>

      <!-- Sell tab -->
      <div class="trade-body" id="sellTabBody">
        <div class="balance-mini">
          <div class="bm-block">
            <div class="label">Wallet</div>
            <div class="value">Ksh <%= user.walletBalance %></div>
          </div>
          <div class="bm-block coin">
            <div class="label">Coins Held</div>
            <div class="value"><%= user.coinBalance %> VJC</div>
          </div>
        </div>

        <div class="field-label">
          You Sell
          <span class="max-link" onclick="setSellMax()">MAX</span>
        </div>
        <div class="amount-input-wrap">
          <input type="number" id="quickSellAmount" step="0.01" min="0.01" max="<%= user.coinBalance %>" placeholder="0.00" oninput="updateQuickSell()">
          <span class="unit">VJC</span>
        </div>

        <div class="swap-icon">&#8595;</div>

        <div class="field-label">Baseline Value (locked at listing)</div>
        <div class="amount-input-wrap">
          <input type="text" id="quickSellValue" value="0.00" readonly>
          <span class="unit">KSH</span>
        </div>

        <div class="rate-row"><span>Baseline price</span><span class="rv">Ksh <%= market.currentPrice %> / VJC</span></div>

        <form id="sellForm" action="/vault-coin/sell" method="POST">
          <input type="hidden" name="coinsAmount" id="sellFormCoinsAmount">
          <button type="button" class="trade-submit-btn sell" onclick="confirmQuickSell()">List Sell Order</button>
        </form>
        <div class="trade-hint">Your coins lock into escrow immediately at today's price as your baseline. If the market later drops below it, you'll be alerted before it fills.</div>
      </div>
    </div>
  </div>

  <!-- My open sell orders -->
  <% if (myOrders.length) { %>
  <div class="section">
    <h2>My Sell Orders</h2>
    <div class="order-table-wrap">
      <table class="order-book">
        <thead>
          <tr>
            <th>Listed</th>
            <th>Remaining</th>
            <th>Baseline</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% myOrders.forEach(o => { const dropped = market.currentPrice < o.baselinePrice; %>
          <tr>
            <td><%= o.coinsAmount %> VJC</td>
            <td><%= o.coinsRemaining %> VJC</td>
            <td>Ksh <%= o.baselinePrice %></td>
            <td>
              <% if (dropped) { %>
                <span class="badge badge-warning">Price dropped &mdash; will fill at Ksh <%= market.currentPrice %></span>
              <% } else if (o.status === 'partial') { %>
                <span class="badge badge-partial">Partially filled</span>
              <% } else { %>
                <span class="badge badge-active">Active</span>
              <% } %>
            </td>
            <td>
              <form action="/vault-coin/cancel/<%= o._id %>" method="POST" onsubmit="return confirm('Cancel this order and return coins to your wallet?');">
                <button type="submit" class="cancel-row-btn">Cancel</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  <!-- Open market order book -->
  <div class="section">
    <h2>Order Book &mdash; Live Sell Listings</h2>
    <div class="order-table-wrap">
      <% if (openOrders.length) { %>
      <table class="order-book">
        <thead>
          <tr>
            <th>Seller</th>
            <th>Available</th>
            <th>Baseline</th>
            <th>Executes At</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% openOrders.forEach(o => {
               const executesAt = market.currentPrice >= o.baselinePrice ? o.baselinePrice : market.currentPrice;
               const cls = market.currentPrice >= o.baselinePrice ? 'up' : 'down';
          %>
          <tr>
            <td><%= o.seller.username %></td>
            <td><%= o.coinsRemaining %> VJC</td>
            <td>Ksh <%= o.baselinePrice %></td>
            <td class="price-cell <%= cls %>">Ksh <%= market.currentPrice %></td>
            <td>
              <button
                type="button"
                class="buy-row-btn"
                onclick="openBuyModal('<%= o._id %>', '<%= o.seller.username %>', <%= o.coinsRemaining %>, <%= market.currentPrice %>)"
              >
                Buy
              </button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } else { %>
        <div class="empty-state">No active sell orders right now. Be the first to list one.</div>
      <% } %>
    </div>
  </div>

  <!-- Recent trades -->
  <% if (recentTrades.length) { %>
  <div class="section">
    <h2>My Recent Trades</h2>
    <% recentTrades.forEach(t => {
         const isBuyer = String(t.buyer) === String(user._id);
    %>
      <div class="trade-item <%= isBuyer ? 'as-buyer' : 'as-seller' %>">
        <div>
          <div class="t-main"><%= isBuyer ? 'Bought' : 'Sold' %> <%= t.coinsTraded %> VJC</div>
          <div class="t-sub">@ Ksh <%= t.executionPrice %>/coin &middot; <%= new Date(t.createdAt).toLocaleString() %></div>
        </div>
        <div class="t-main" style="color:<%= isBuyer ? '#0ecb81' : '#f6465d' %>">
          <%= isBuyer ? '-Ksh ' + t.buyerPaidCash.toFixed(2) : '+Ksh ' + t.sellerReceivedCash.toFixed(2) %>
        </div>
      </div>
    <% }) %>
  </div>
  <% } %>

  <!-- Buy Modal (per-seller, from order book rows) -->
  <div class="modal-overlay" id="buyModalOverlay">
    <div class="modal-box">
      <div class="modal-header">Buy VaultJ Coin</div>
      <div class="modal-body">
        <p>Buying from <strong id="buySellerName"></strong> &middot; <span id="buyAvailable"></span> VJC available.</p>
        <label>Amount to buy</label>
        <input type="number" id="buyCoinsAmount" step="0.01" min="0.01" oninput="updateBuySummary()">
        <div class="modal-summary">
          <div><span>Live price</span><span id="buyLivePrice">Ksh 0/coin</span></div>
          <div><span>You pay (cash)</span><span id="buyTotalCash" class="red">Ksh 0.00</span></div>
          <div><span>You receive (after 5% fee)</span><span id="buyCoinsReceived" class="green">0.00 VJC</span></div>
        </div>
      </div>
      <div class="modal-actions">
        <button type="button" class="modal-cancel" onclick="closeBuyModal()">Cancel</button>
        <button type="button" class="modal-confirm" onclick="confirmBuy()">Confirm Buy</button>
      </div>
    </div>
  </div>

  <form id="buyForm" method="POST" style="display:none;">
    <input type="hidden" name="coinsAmount" id="buyFormCoinsAmount">
  </form>

  <script>
    const marketPrice = <%= market.currentPrice %>;
    const rawHistory = <%- JSON.stringify(market.priceHistory.map(h => ({ price: h.price, t: h.changedAt }))) %>;
    const openOrdersData = <%- JSON.stringify(openOrders.map(o => ({ id: o._id, remaining: o.coinsRemaining, baseline: o.baselinePrice, seller: o.seller.username }))) %>;
    const userCoinBalance = <%= user.coinBalance %>;

    // ---- Chart: timeframe filtering + drawing ----
    let currentRange = '1D';

    function filterHistoryByRange(range) {
      if (!rawHistory.length) return [marketPrice, marketPrice];
      const now = new Date();
      let cutoff = null;
      if (range === '1D') { cutoff = new Date(now); cutoff.setDate(cutoff.getDate() - 1); }
      else if (range === '7D') { cutoff = new Date(now); cutoff.setDate(cutoff.getDate() - 7); }
      else if (range === '1M') { cutoff = new Date(now); cutoff.setMonth(cutoff.getMonth() - 1); }
      else if (range === '3M') { cutoff = new Date(now); cutoff.setMonth(cutoff.getMonth() - 3); }

      let filtered = cutoff
        ? rawHistory.filter(h => new Date(h.t) >= cutoff)
        : rawHistory.slice();

      if (filtered.length < 2) filtered = rawHistory.slice(-2);
      if (filtered.length < 1) filtered = [{ price: marketPrice, t: now }];
      return filtered.map(h => h.price);
    }

    function drawChart(range) {
      const canvas = document.getElementById('priceChart');
      const emptyMsg = document.getElementById('chartEmptyMsg');
      const data = filterHistoryByRange(range);

      emptyMsg.style.display = data.length < 2 ? 'block' : 'none';

      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = 320 * dpr;
      const ctx = canvas.getContext('2d');
      ctx.scale(dpr, dpr);

      const W = rect.width;
      const H = 320;
      const padding = { top: 20, right: 20, bottom: 24, left: 55 };
      const chartW = W - padding.left - padding.right;
      const chartH = H - padding.top - padding.bottom;

      ctx.clearRect(0, 0, W, H);

      const max = Math.max(...data);
      const min = Math.min(...data);
      const range_ = (max - min) || 1;

      function xFor(i) { return padding.left + (i / (Math.max(data.length - 1, 1))) * chartW; }
      function yFor(v) { return padding.top + chartH - ((v - min) / range_) * chartH; }

      ctx.strokeStyle = '#1f2430';
      ctx.lineWidth = 1;
      for (let g = 0; g <= 4; g++) {
        const y = padding.top + (chartH / 4) * g;
        ctx.beginPath();
        ctx.moveTo(padding.left, y);
        ctx.lineTo(W - padding.right, y);
        ctx.stroke();

        const val = max - (range_ / 4) * g;
        ctx.fillStyle = '#848e9c';
        ctx.font = '11px Arial';
        ctx.textAlign = 'right';
        ctx.fillText('Ksh ' + val.toFixed(1), padding.left - 8, y + 4);
      }

      const overallUp = data[data.length - 1] >= data[0];
      const lineColor = overallUp ? '#0ecb81' : '#f6465d';

      const gradient = ctx.createLinearGradient(0, padding.top, 0, padding.top + chartH);
      gradient.addColorStop(0, overallUp ? 'rgba(14,203,129,0.25)' : 'rgba(246,70,93,0.25)');
      gradient.addColorStop(1, overallUp ? 'rgba(14,203,129,0)' : 'rgba(246,70,93,0)');

      ctx.beginPath();
      ctx.moveTo(xFor(0), yFor(data[0]));
      data.forEach((v, i) => ctx.lineTo(xFor(i), yFor(v)));
      ctx.lineTo(xFor(data.length - 1), padding.top + chartH);
      ctx.lineTo(xFor(0), padding.top + chartH);
      ctx.closePath();
      ctx.fillStyle = gradient;
      ctx.fill();

      for (let i = 1; i < data.length; i++) {
        ctx.beginPath();
        ctx.moveTo(xFor(i - 1), yFor(data[i - 1]));
        ctx.lineTo(xFor(i), yFor(data[i]));
        ctx.strokeStyle = data[i] >= data[i - 1] ? '#0ecb81' : '#f6465d';
        ctx.lineWidth = 2.5;
        ctx.lineCap = 'round';
        ctx.stroke();
      }

      data.forEach((v, i) => {
        ctx.beginPath();
        ctx.arc(xFor(i), yFor(v), 3, 0, Math.PI * 2);
        ctx.fillStyle = i === data.length - 1 ? '#f0b90b' : lineColor;
        ctx.fill();
      });

      const lastY = yFor(data[data.length - 1]);
      ctx.setLineDash([4, 4]);
      ctx.strokeStyle = '#f0b90b';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(padding.left, lastY);
      ctx.lineTo(W - padding.right, lastY);
      ctx.stroke();
      ctx.setLineDash([]);

      // Update stat cells for this range
      const rHigh = Math.max(...data);
      const rLow = Math.min(...data);
      const rFirst = data[0];
      const rChange = rFirst ? (((data[data.length - 1] - rFirst) / rFirst) * 100).toFixed(2) : '0.00';
      document.getElementById('rangeHigh').textContent = 'Ksh ' + rHigh.toFixed(2);
      document.getElementById('rangeLow').textContent = 'Ksh ' + rLow.toFixed(2);
      const rangeChangeEl = document.getElementById('rangeChange');
      rangeChangeEl.textContent = rChange + '%';
      rangeChangeEl.className = 'val ' + (rChange >= 0 ? 'green' : 'red');
    }

    document.querySelectorAll('.tf-tab').forEach(tab => {
      tab.addEventListener('click', function () {
        document.querySelectorAll('.tf-tab').forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        currentRange = this.dataset.range;
        const labels = { '1D': 'Today', '7D': 'Last 7 days', '1M': 'Last month', '3M': 'Last 3 months', 'ALL': 'All time' };
        document.getElementById('rangeLabel').textContent = labels[currentRange];
        drawChart(currentRange);
      });
    });

    window.addEventListener('load', () => drawChart(currentRange));
    window.addEventListener('resize', () => drawChart(currentRange));

    // ---- Trade panel tab switching ----
    function switchTradeTab(which) {
      document.querySelectorAll('.trade-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.trade-body').forEach(b => b.classList.remove('active'));
      document.querySelector('.trade-tab.' + which).classList.add('active');
      document.getElementById(which + 'TabBody').classList.add('active');
    }

    // ---- Quick Buy (matches against cheapest open orders) ----
    function updateQuickBuy() {
      const amt = parseFloat(document.getElementById('quickBuyAmount').value) || 0;
      document.getElementById('quickBuySpend').value = (amt * marketPrice).toFixed(2);
      document.getElementById('quickBuyReceive').textContent = (amt * 0.95).toFixed(2) + ' VJC';
    }

    function submitQuickBuy() {
      const amt = parseFloat(document.getElementById('quickBuyAmount').value);
      if (!amt || amt <= 0) { alert('Enter a valid amount to buy.'); return; }

      const sorted = openOrdersData.slice().sort((a, b) => a.baseline - b.baseline);
      const match = sorted.find(o => o.remaining >= amt);

      if (!match) {
        const totalAvailable = sorted.reduce((sum, o) => sum + o.remaining, 0);
        if (totalAvailable === 0) {
          alert('No open sell orders available right now.');
        } else {
          alert('No single seller has ' + amt + ' VJC available. Total across all sellers is ' + totalAvailable.toFixed(2) + ' VJC — buy in smaller amounts from the Order Book below.');
        }
        return;
      }

      if (!confirm('Buy ' + amt + ' VJC from ' + match.seller + ' at Ksh ' + marketPrice + '/coin?')) return;

      document.getElementById('buyFormCoinsAmount').value = amt;
      document.getElementById('buyForm').action = '/vault-coin/buy/' + match.id;
      document.getElementById('buyForm').submit();
    }

    // ---- Quick Sell ----
    function updateQuickSell() {
      const amt = parseFloat(document.getElementById('quickSellAmount').value) || 0;
      document.getElementById('quickSellValue').value = (amt * marketPrice).toFixed(2);
    }
    function setSellMax() {
      document.getElementById('quickSellAmount').value = userCoinBalance;
      updateQuickSell();
    }
    function confirmQuickSell() {
      const amt = parseFloat(document.getElementById('quickSellAmount').value);
      if (!amt || amt <= 0) { alert('Enter a valid coin amount to sell.'); return; }
      if (amt > userCoinBalance) { alert('You only have ' + userCoinBalance + ' VJC available.'); return; }
      document.getElementById('sellFormCoinsAmount').value = amt;
      document.getElementById('sellForm').submit();
    }

    // ---- Per-seller Buy modal (from order book rows) ----
    let currentBuyMax = 0;
    let currentBuyPrice = 0;

    function openBuyModal(orderId, sellerName, available, livePrice) {
      currentBuyMax = available;
      currentBuyPrice = livePrice;

      document.getElementById('buySellerName').textContent = sellerName;
      document.getElementById('buyAvailable').textContent = available;
      document.getElementById('buyLivePrice').textContent = 'Ksh ' + livePrice + '/coin';
      document.getElementById('buyCoinsAmount').value = '';
      document.getElementById('buyCoinsAmount').max = available;
      document.getElementById('buyTotalCash').textContent = 'Ksh 0.00';
      document.getElementById('buyCoinsReceived').textContent = '0.00 VJC';
      document.getElementById('buyForm').action = '/vault-coin/buy/' + orderId;
      document.getElementById('buyModalOverlay').classList.add('open');
    }
    function closeBuyModal() {
      document.getElementById('buyModalOverlay').classList.remove('open');
    }
    function updateBuySummary() {
      let amt = parseFloat(document.getElementById('buyCoinsAmount').value) || 0;
      if (amt > currentBuyMax) amt = currentBuyMax;
      document.getElementById('buyTotalCash').textContent = 'Ksh ' + (amt * currentBuyPrice).toFixed(2);
      document.getElementById('buyCoinsReceived').textContent = (amt * 0.95).toFixed(2) + ' VJC';
    }
    function confirmBuy() {
      const amt = parseFloat(document.getElementById('buyCoinsAmount').value);
      if (!amt || amt <= 0 || amt > currentBuyMax) { alert('Enter a valid amount (up to ' + currentBuyMax + ').'); return; }
      document.getElementById('buyFormCoinsAmount').value = amt;
      document.getElementById('buyForm').submit();
    }

    document.getElementById('buyModalOverlay').addEventListener('click', function (e) {
      if (e.target === this) closeBuyModal();
    });
  </script>

  <%- include('partials/footer') %>
</body>
</html>