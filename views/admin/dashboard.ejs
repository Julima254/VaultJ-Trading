<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <script src="/vendor/chart.umd.js"></script>
  <style>
    :root {
      --dark-blue: #0a1f44;
      --dark-blue-light: #12294f;
      --gold: #d4af37;
      --green: #1f9d55;
      --red: #d9534f;
      --light-grey: #f4f5f7;
      --border-grey: #e3e5e9;
      --text-dark: #1b1f27;
      --text-muted: #6b7280;
      --sidebar-width: 250px;
      --topbar-height: 60px; /* height of the mobile/tablet hamburger bar, adjust to match your header */
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--light-grey);
      color: var(--text-dark);
    }

    /* ---- Main content area ---- */
    /* Desktop: pushed right to make room for the fixed sidebar */
    .admin-main {
      margin-left: var(--sidebar-width);
      padding: 28px 32px 60px;
      min-height: 100vh;
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .page-header h1 {
      font-size: 22px;
      color: var(--dark-blue);
      margin: 0;
    }

    .page-header .date-badge {
      background: var(--dark-blue);
      color: var(--gold);
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
      white-space: nowrap;
    }

    /* ---- Stat cards grid ---- */
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      margin-bottom: 28px;
    }

    .stat-card {
      background: #fff;
      border-radius: 12px;
      padding: 18px 20px;
      border-left: 5px solid var(--dark-blue);
      box-shadow: 0 2px 6px rgba(10, 31, 68, 0.06);
      min-width: 0; /* prevents grid blowout with long numbers */
    }

    .stat-card .label {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
      margin-bottom: 6px;
    }

    .stat-card .value {
      font-size: 22px;
      font-weight: 700;
      color: var(--dark-blue);
      word-break: break-word;
    }

    .stat-card.gold { border-left-color: var(--gold); }
    .stat-card.gold .value { color: #a8821f; }

    .stat-card.green { border-left-color: var(--green); }
    .stat-card.green .value { color: var(--green); }

    .stat-card.red { border-left-color: var(--red); }
    .stat-card.red .value { color: var(--red); }

    .stat-card .sub {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 4px;
    }

    /* ---- Section cards ---- */
    .section-card {
      background: #fff;
      border-radius: 12px;
      padding: 20px 22px;
      margin-bottom: 24px;
      box-shadow: 0 2px 6px rgba(10, 31, 68, 0.06);
    }

    .section-card h2 {
      font-size: 16px;
      color: var(--dark-blue);
      margin: 0 0 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .section-card h2::before {
      content: "";
      width: 4px;
      height: 16px;
      background: var(--gold);
      display: inline-block;
      border-radius: 2px;
      flex-shrink: 0;
    }

    .two-col-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 20px;
      margin-bottom: 24px;
    }

    /* ---- Chart container ---- */
    .chart-wrapper {
      position: relative;
      height: 300px;
      width: 100%;
    }

    /* ---- Tables ---- */
    /* wrapper allows horizontal scroll on small screens without breaking page layout */
    .table-scroll {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13.5px;
    }

    thead th {
      text-align: left;
      background: var(--dark-blue);
      color: #fff;
      padding: 10px 12px;
      font-weight: 600;
      white-space: nowrap;
    }

    thead th:first-child { border-radius: 8px 0 0 8px; }
    thead th:last-child { border-radius: 0 8px 8px 0; }

    tbody td {
      padding: 10px 12px;
      border-bottom: 1px solid var(--border-grey);
      color: var(--text-dark);
      white-space: nowrap;
    }

    tbody tr:hover { background: #fafbfc; }

    .badge {
      padding: 3px 10px;
      border-radius: 12px;
      font-size: 11.5px;
      font-weight: 600;
      text-transform: capitalize;
      white-space: nowrap;
    }

    .badge.completed { background: rgba(31, 157, 85, 0.12); color: var(--green); }
    .badge.pending { background: rgba(212, 175, 55, 0.15); color: #a8821f; }
    .badge.failed { background: rgba(217, 83, 79, 0.12); color: var(--red); }

    .badge.type-deposit { background: rgba(31, 157, 85, 0.12); color: var(--green); }
    .badge.type-withdraw { background: rgba(217, 83, 79, 0.12); color: var(--red); }
    .badge.type-upgrade { background: rgba(10, 31, 68, 0.1); color: var(--dark-blue); }
    .badge.type-referral { background: rgba(212, 175, 55, 0.15); color: #a8821f; }
    .badge.type-spin { background: rgba(107, 114, 128, 0.12); color: var(--text-muted); }

    .status-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      margin-right: 6px;
    }
    .status-dot.active { background: var(--green); }
    .status-dot.inactive { background: var(--text-muted); }

    .empty-row td {
      text-align: center;
      color: var(--text-muted);
      padding: 24px;
      white-space: normal;
    }

    /* =========================================================
       RESPONSIVE BREAKPOINTS
       Desktop  : > 1024px  -> fixed left sidebar, content pushed right
       Tablet   : 769px - 1024px -> hamburger top bar, full-width content
       Mobile   : <= 768px -> hamburger top bar, full-width content, stacked cards
    ========================================================= */

    /* ---- Tablet & Mobile: sidebar becomes hamburger, no left space ---- */
    @media (max-width: 1024px) {
      .admin-main {
        margin-left: 0;              /* no reserved space for sidebar */
        padding: 20px 20px 50px;
        padding-top: calc(var(--topbar-height) + 16px); /* room for fixed hamburger bar, remove if your header isn't fixed */
      }

      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .two-col-grid {
        grid-template-columns: 1fr;
      }
    }

    /* ---- Tablet fine-tuning ---- */
    @media (max-width: 1024px) and (min-width: 601px) {
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
      }
    }

    /* ---- Mobile ---- */
    @media (max-width: 600px) {
      .admin-main {
        padding: 16px 14px 40px;
        padding-top: calc(var(--topbar-height) + 12px);
      }

      .page-header {
        margin-bottom: 18px;
      }

      .page-header h1 {
        font-size: 19px;
      }

      .stats-grid {
        grid-template-columns: 1fr 1fr; /* keep 2-up even on phones; use 1fr for full single column */
        gap: 12px;
        margin-bottom: 20px;
      }

      .stat-card {
        padding: 14px 14px;
        border-radius: 10px;
      }

      .stat-card .value {
        font-size: 18px;
      }

      .stat-card .label {
        font-size: 11px;
      }

      .section-card {
        padding: 16px 14px;
        margin-bottom: 18px;
        border-radius: 10px;
      }

      .section-card h2 {
        font-size: 14.5px;
        margin-bottom: 12px;
      }

      .chart-wrapper {
        height: 240px;
      }

      table {
        font-size: 12.5px;
      }

      thead th,
      tbody td {
        padding: 8px 10px;
      }
    }

    /* ---- Very small phones ---- */
    @media (max-width: 380px) {
      .stats-grid {
        grid-template-columns: 1fr; /* single column on very narrow screens */
      }
    }
  </style>
</head>
<body>
  <%- include('../partials/adminHeader') %>

  <main class="admin-main">
    <div class="page-header">
      <h1>Admin Dashboard</h1>
      <span class="date-badge"><%= new Date().toDateString() %></span>
    </div>

    <!-- ==== TOP STAT CARDS ==== -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="label">Total Users</div>
        <div class="value"><%= stats.totalUsers %></div>
        <div class="sub"><%= stats.activeUsers %> active</div>
      </div>

      <div class="stat-card green">
        <div class="label">Total Deposits</div>
        <div class="value">KES <%= stats.totalDeposits.toLocaleString() %></div>
        <div class="sub">This month: KES <%= stats.depositsThisMonth.toLocaleString() %></div>
      </div>

      <div class="stat-card red">
        <div class="label">Total Withdrawals</div>
        <div class="value">KES <%= stats.totalWithdrawals.toLocaleString() %></div>
        <div class="sub">This month: KES <%= stats.withdrawalsThisMonth.toLocaleString() %></div>
      </div>

      <div class="stat-card gold">
        <div class="label">Platform Profit</div>
        <div class="value">KES <%= stats.platformProfit.toLocaleString() %></div>
        <div class="sub">Deposits − Withdrawals</div>
      </div>

      <div class="stat-card">
        <div class="label">Users' Funds</div>
        <div class="value">KES <%= stats.usersFunds.toLocaleString() %></div>
        <div class="sub">Wallet + deposit balances</div>
      </div>

      <div class="stat-card gold">
        <div class="label">Pending Deposits</div>
        <div class="value">KES <%= stats.pendingDeposits.sum.toLocaleString() %></div>
        <div class="sub"><%= stats.pendingDeposits.count %> awaiting approval</div>
      </div>

      <div class="stat-card gold">
        <div class="label">Pending Withdrawals</div>
        <div class="value">KES <%= stats.pendingWithdrawals.sum.toLocaleString() %></div>
        <div class="sub"><%= stats.pendingWithdrawals.count %> awaiting approval</div>
      </div>

      <div class="stat-card">
        <div class="label">Active Users</div>
        <div class="value"><%= stats.activeUsers %></div>
        <div class="sub">of <%= stats.totalUsers %> total</div>
      </div>
    </div>

    <!-- ==== CHART + RECENT USERS ==== -->
    <div class="two-col-grid">
      <div class="section-card">
        <h2>Deposits vs Withdrawals (Last 7 Days)</h2>
        <div class="chart-wrapper">
          <canvas id="depositWithdrawalChart"></canvas>
        </div>
      </div>

      <div class="section-card">
        <h2>Recent Users</h2>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>User</th>
                <th>Package</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentUsers && recentUsers.length) { %>
                <% recentUsers.forEach(function(u) { %>
                  <tr>
                    <td>
                      <strong><%= u.username %></strong><br>
                      <span style="color: var(--text-muted); font-size: 12px;"><%= u.email %></span>
                    </td>
                    <td><%= u.package %></td>
                    <td>
                      <span class="status-dot <%= u.isActive ? 'active' : 'inactive' %>"></span>
                      <%= u.isActive ? 'Active' : 'Inactive' %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr class="empty-row"><td colspan="3">No users yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ==== RECENT TRANSACTIONS ==== -->
    <div class="section-card">
      <h2>Recent Transactions</h2>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>User</th>
              <th>Type</th>
              <th>Amount</th>
              <th>Method</th>
              <th>Status</th>
              <th>Code / Note</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentTransactions && recentTransactions.length) { %>
              <% recentTransactions.forEach(function(tx) { %>
                <tr>
                  <td>
                    <strong><%= tx.userId ? tx.userId.username : 'Unknown' %></strong><br>
                    <span style="color: var(--text-muted); font-size: 12px;">
                      <%= tx.userId ? tx.userId.email : '' %>
                    </span>
                  </td>
                  <td>
                    <span class="badge type-<%= tx.type %>"><%= tx.type %></span>
                  </td>
                  <td>KES <%= tx.amount.toLocaleString() %></td>
                  <td><%= tx.method %></td>
                  <td>
                    <span class="badge <%= tx.status %>"><%= tx.status %></span>
                  </td>
                  <td>
                    <% if (tx.code) { %>
                      <%= tx.code %>
                    <% } else if (tx.note) { %>
                      <span style="color: var(--text-muted); font-size: 12px;"><%= tx.note %></span>
                    <% } else { %>
                      —
                    <% } %>
                  </td>
                  <td><%= new Date(tx.createdAt).toLocaleString() %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr class="empty-row"><td colspan="7">No transactions yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <script>
    const ctx = document.getElementById('depositWithdrawalChart');
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: <%- JSON.stringify(chart.labels) %>,
        datasets: [
          {
            label: 'Deposits',
            data: <%- JSON.stringify(chart.deposits) %>,
            backgroundColor: '#1f9d55',
            borderRadius: 4,
          },
          {
            label: 'Withdrawals',
            data: <%- JSON.stringify(chart.withdrawals) %>,
            backgroundColor: '#d9534f',
            borderRadius: 4,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'bottom' },
        },
        scales: {
          y: { beginAtZero: true, grid: { color: '#eee' } },
          x: { grid: { display: false } },
        },
      },
    });
  </script>
</body>
</html>