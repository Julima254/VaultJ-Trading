<%- include('../partials/adminHeader.ejs'); -%>

<style>
    :root {
        --dark-blue: #001f3f;
        --gold: #FFD700;
        --green: #28a745;
        --soft-bg: #f8f9fa;
    }
    .main-content-wrapper { margin-left: 260px; padding: 30px; background: var(--soft-bg); min-height: 100vh; }
    @media (max-width: 992px) { .main-content-wrapper { margin-left: 0; } }

    .stat-card {
        border: none;
        border-radius: 15px;
        color: white;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        transition: transform 0.2s;
    }
    .stat-card:hover { transform: translateY(-5px); }
    
    .bg-vault-blue { background: var(--dark-blue); }
    .bg-vault-gold { background: var(--gold); color: var(--dark-blue) !important; }
    .bg-vault-green { background: var(--green); }

    .transaction-table { background: white; border-radius: 15px; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
    .transaction-table thead { background: var(--dark-blue); color: var(--gold); }
    
    .user-badge { font-size: 0.8rem; padding: 5px 12px; border-radius: 20px; font-weight: bold; }
    
    /* Success Alert Styling */
    .alert-vault {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
        border-radius: 12px;
    }
</style>

<div class="main-content-wrapper">
    <div class="container-fluid">
        
        <% if (success && success.length > 0) { %>
            <div class="alert alert-vault alert-dismissible fade show border-0 shadow-sm mb-4 p-3" role="alert">
                <div class="d-flex align-items-center">
                    <i class="fas fa-check-circle me-3 fa-2x"></i>
                    <div>
                        <strong class="d-block">Admin Action Successful</strong>
                        <span id="payoutCode"><%= success %></span>
                    </div>
                    <button class="btn btn-dark btn-sm ms-auto rounded-pill px-3" onclick="copyCode()">
                        <i class="fas fa-copy me-1"></i> Copy Code
                    </button>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
            
            <script>
                function copyCode() {
                    const fullText = document.getElementById('payoutCode').innerText;
                    // Regex to grab the password after the colon
                    const code = fullText.split(': ').pop().split('.')[0].trim();
                    navigator.clipboard.writeText(code);
                    alert("Password copied: " + code);
                }
            </script>
        <% } %>

        <% if (error && error.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4" role="alert">
                <i class="fas fa-exclamation-triangle me-2"></i> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a href="/admin/users" class="btn btn-sm btn-outline-secondary mb-2 rounded-pill">
                    <i class="fas fa-arrow-left"></i> Back to Users
                </a>
                <h2 class="fw-bold text-dark mb-0">User: <%= user.username %></h2>
                <p class="text-muted small">Registered on: <%= (user.createdAt && user.createdAt.toDateString) ? user.createdAt.toDateString() : 'N/A' %></p>
            </div>
            <div class="text-end">
                <span class="user-badge <%= user.isActive ? 'bg-success' : 'bg-danger' %> text-white shadow-sm">
                    <i class="fas <%= user.isActive ? 'fa-check' : 'fa-ban' %> me-1"></i>
                    <%= user.isActive ? 'ACTIVE ACCOUNT' : 'SUSPENDED' %>
                </span>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="stat-card bg-vault-blue">
                    <small class="opacity-75">Wallet Balance</small>
                    <h3 class="fw-bold mb-0">Ksh <%= (user.walletBalance || 0).toLocaleString() %></h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card bg-vault-gold">
                    <small class="opacity-75">VTC Holdings</small>
                    <h3 class="fw-bold mb-0"><%= user.coinsBalance || 0 %> VTC</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card bg-vault-green text-white">
                    <small class="opacity-75">Downline Count</small>
                    <h3 class="fw-bold mb-0"><%= referrals ? referrals.length : 0 %> Referrals</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card bg-secondary">
                    <small class="opacity-75">Internal ID</small>
                    <p class="mb-0 small" style="word-break: break-all;"><%= user._id %></p>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="transaction-table p-4 mb-4">
                    <h5 class="fw-bold mb-3"><i class="fas fa-history text-primary me-2"></i> Recent Transactions</h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(transactions && transactions.length > 0) { %>
                                    <% transactions.forEach(tx => { %>
                                        <tr>
                                            <td>
                                                <span class="text-capitalize fw-bold text-dark"><%= tx.type.replace('_', ' ') %></span>
                                                <br><small class="text-muted"><%= tx.phone || 'SYSTEM' %></small>
                                            </td>
                                            <td class="<%= (tx.type === 'deposit' || tx.amount > 0) ? 'text-success' : 'text-danger' %> fw-bold">
                                                <%= (tx.type === 'deposit' || tx.amount > 0) ? '+' : '-' %> Ksh <%= Math.abs(tx.amount).toLocaleString() %>
                                            </td>
                                            <td>
                                                <span class="badge rounded-pill <%= tx.status === 'completed' ? 'bg-success' : 'bg-warning text-dark' %>">
                                                    <%= tx.status %>
                                                </span>
                                            </td>
                                            <td><%= (tx.createdAt && tx.createdAt.toLocaleDateString) ? tx.createdAt.toLocaleDateString() : 'N/A' %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="4" class="text-center py-5 text-muted">No transaction history found for this user.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body">
                        <h5 class="fw-bold border-bottom pb-2 mb-3">User Profile</h5>
                        <p class="mb-2"><strong>Email:</strong> <span class="text-muted"><%= user.email %></span></p>
                        <p class="mb-2"><strong>Phone:</strong> <span class="text-muted"><%= user.phone || 'N/A' %></span></p>
                        <p class="mb-2"><strong>Country:</strong> <span class="text-muted"><%= user.country || 'Kenya' %></span></p>
                        <p class="mb-0"><strong>Referrer:</strong> <span class="badge bg-light text-primary">@<%= user.referredBy || 'None' %></span></p>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header bg-vault-blue text-white py-3">
                        <h5 class="fw-bold mb-0"><i class="fas fa-user-shield me-2 text-gold"></i> Admin Actions</h5>
                    </div>
                    <div class="card-body">
                        <form action="/admin/users/<%= user._id %>/toggle-status" method="POST" class="mb-3">
                            <button type="submit" class="btn <%= user.isActive ? 'btn-danger' : 'btn-success' %> w-100 py-2 fw-bold shadow-sm">
                                <i class="fas <%= user.isActive ? 'fa-user-slash' : 'fa-user-check' %> me-2"></i>
                                <%= user.isActive ? 'Suspend Account' : 'Reactivate Account' %>
                            </button>
                        </form>

                        <form action="/admin/users/<%= user._id %>/reset-password" method="POST">
                            <button type="submit" class="btn btn-outline-dark w-100 py-2 fw-bold" 
                                    onclick="return confirm('WARNING: This will generate a new password immediately. The user will be logged out. Continue?')">
                                <i class="fas fa-key me-2 text-gold"></i> Reset Password (Manual)
                            </button>
                        </form>
                        <p class="text-center small text-muted mt-2 mb-0">New password will appear at top of page.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>