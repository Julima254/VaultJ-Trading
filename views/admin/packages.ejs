<%- include('../partials/adminHeader') %>

<style>
  :root {
    --dark-blue: #0a1f44;
    --dark-blue-light: #12305e;
    --gold: #d4af37;
    --gold-light: #e8c96b;
    --green: #1f9d55;
    --green-light: #e6f6ec;
    --red: #b42318;
    --red-light: #fdecec;
    --light-gray: #f4f5f7;
    --border-gray: #e1e3e8;
    --text-muted: #6b7280;
  }

  .admin-content-wrap,
  .admin-content-wrap * {
    font-family: inherit;
  }

  .admin-content-wrap {
    background: var(--light-gray);
    min-height: 100vh;
    padding: 24px;
  }

  @media (min-width: 992px) {
    .admin-content-wrap {
      margin-left: 260px;
      padding: 32px 40px;
    }
  }

  .pkg-page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }

  .pkg-page-header h1 {
    color: var(--dark-blue);
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0;
  }

  .pkg-page-header p {
    color: var(--text-muted);
    margin: 4px 0 0;
    font-size: 0.92rem;
  }

  .pkg-summary-bar {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .pkg-summary-chip {
    background: #fff;
    border: 1px solid var(--border-gray);
    border-left: 4px solid var(--gold);
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 0.85rem;
    color: var(--dark-blue);
  }

  .pkg-summary-chip strong {
    display: block;
    font-size: 1.1rem;
    color: var(--dark-blue);
  }

  .pkg-summary-chip.chip-neutral { border-left-color: var(--text-muted); }
  .pkg-summary-chip.chip-warn { border-left-color: var(--red); }
  .pkg-summary-chip.chip-good { border-left-color: var(--green); }

  .pkg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }

  .pkg-card {
    background: #fff;
    border-radius: 12px;
    border: 1px solid var(--border-gray);
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(10, 31, 68, 0.06);
    display: flex;
    flex-direction: column;
  }

  .pkg-card-top {
    background: linear-gradient(135deg, var(--dark-blue) 0%, var(--dark-blue-light) 100%);
    color: #fff;
    padding: 18px 20px;
    position: relative;
  }

  .pkg-card-top::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--gold);
  }

  .pkg-card-top .pkg-key {
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--gold-light);
    font-weight: 600;
  }

  .pkg-card-top h3 {
    margin: 4px 0 0;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .pkg-card-body {
    padding: 18px 20px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pkg-price {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--dark-blue);
  }

  .pkg-price span {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .pkg-meta-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    color: var(--text-muted);
    border-top: 1px dashed var(--border-gray);
    padding-top: 10px;
  }

  .pkg-meta-row strong {
    color: var(--dark-blue);
  }

  .pkg-badge-green {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--green-light);
    color: var(--green);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
    width: fit-content;
  }

  .pkg-badge-green::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
  }

  .pkg-card-footer {
    padding: 14px 20px;
    border-top: 1px solid var(--border-gray);
    display: flex;
    gap: 8px;
  }

  .pkg-btn {
    flex: 1;
    text-align: center;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .pkg-btn:hover { opacity: 0.88; }

  .pkg-btn-gold {
    background: var(--gold);
    color: var(--dark-blue);
  }

  .pkg-btn-outline {
    background: #fff;
    color: var(--dark-blue);
    border: 1px solid var(--border-gray);
  }

  .pkg-two-col {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 20px;
    align-items: start;
  }

  @media (max-width: 900px) {
    .pkg-two-col { grid-template-columns: 1fr; }
  }

  .pkg-table-section {
    background: #fff;
    border-radius: 12px;
    border: 1px solid var(--border-gray);
    overflow: hidden;
    margin-bottom: 24px;
  }

  .pkg-table-section h2 {
    color: var(--dark-blue);
    font-size: 1.05rem;
    margin: 0;
    padding: 18px 20px;
    border-bottom: 1px solid var(--border-gray);
  }

  table.pkg-table {
    width: 100%;
    border-collapse: collapse;
  }

  table.pkg-table thead th {
    background: var(--dark-blue);
    color: #fff;
    text-align: left;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 12px 16px;
  }

  table.pkg-table tbody td {
    padding: 14px 16px;
    font-size: 0.9rem;
    color: var(--dark-blue);
    border-bottom: 1px solid var(--border-gray);
  }

  table.pkg-table tbody tr:hover {
    background: var(--light-gray);
  }

  .pkg-table-name {
    font-weight: 600;
  }

  .pkg-table-key {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 400;
  }

  .pkg-table-link {
    color: var(--dark-blue);
    font-weight: 600;
    font-size: 0.82rem;
    text-decoration: none;
  }

  .pkg-table-link:hover { text-decoration: underline; }

  .pkg-empty {
    padding: 40px 20px;
    text-align: center;
    color: var(--text-muted);
  }

  .pkg-activity-list {
    list-style: none;
    margin: 0;
    padding: 8px 0;
  }

  .pkg-activity-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 20px;
    border-bottom: 1px solid var(--border-gray);
    font-size: 0.85rem;
  }

  .pkg-activity-item:last-child { border-bottom: none; }

  .pkg-activity-user {
    font-weight: 600;
    color: var(--dark-blue);
  }

  .pkg-activity-pkg {
    color: var(--text-muted);
    font-size: 0.78rem;
    display: block;
  }

  .pkg-activity-date {
    color: var(--text-muted);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .alert-box {
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 20px;
    font-size: 0.9rem;
  }

  .alert-error {
    background: #fdecec;
    color: #b42318;
    border: 1px solid #f3c1bd;
  }

  .alert-success {
    background: var(--green-light);
    color: var(--green);
    border: 1px solid #b7e5c6;
  }
</style>

<div class="admin-content-wrap">

  <div class="pkg-page-header">
    <div>
      <h1>Manage Packages</h1>
      <p>Overview of all packages configured on the platform.</p>
    </div>

    <div class="pkg-summary-bar">
      <div class="pkg-summary-chip">
        Total Packages
        <strong><%= Object.keys(packages).length %></strong>
      </div>
      <% if (typeof totalUsers !== 'undefined') { %>
        <div class="pkg-summary-chip">
          Total Users
          <strong><%= totalUsers %></strong>
        </div>
        <div class="pkg-summary-chip chip-good">
          With a Package
          <strong><%= usersWithPackage %></strong>
        </div>
        <div class="pkg-summary-chip chip-warn">
          No Package
          <strong><%= usersWithNoPackage %></strong>
        </div>
        <div class="pkg-summary-chip chip-neutral">
          Adoption Rate
          <strong><%= adoptionRate %>%</strong>
        </div>
      <% } %>
      <% if (typeof stats !== 'undefined' && stats) { %>
        <div class="pkg-summary-chip">
          Total Revenue
          <strong>
            Ksh <%= Object.values(stats).reduce((sum, s) => sum + (s.revenue || 0), 0).toLocaleString() %>
          </strong>
        </div>
      <% } %>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert-box alert-error"><%= error %></div>
  <% } %>
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert-box alert-success"><%= success %></div>
  <% } %>

  <% if (!packages || Object.keys(packages).length === 0) { %>
    <div class="pkg-table-section">
      <div class="pkg-empty">No packages configured yet.</div>
    </div>
  <% } else { %>

    <div class="pkg-grid">
      <% Object.entries(packages).forEach(([key, pkg]) => { %>
        <div class="pkg-card">
          <div class="pkg-card-top">
            <span class="pkg-key"><%= key %></span>
            <h3><%= pkg.name %></h3>
          </div>
          <div class="pkg-card-body">
            <div class="pkg-price">
              Ksh <%= pkg.price?.toLocaleString() %>
              <span>/ activation</span>
            </div>

            <div class="pkg-badge-green">
              <%= ((pkg.referral || 0) * 100).toFixed(0) %>% referral commission
            </div>

            <% if (typeof stats !== 'undefined' && stats && stats[key]) { %>
              <div class="pkg-meta-row">
                <span>Active users</span>
                <strong><%= stats[key].activeUsers || 0 %></strong>
              </div>
              <div class="pkg-meta-row">
                <span>Revenue generated</span>
                <strong>Ksh <%= (stats[key].revenue || 0).toLocaleString() %></strong>
              </div>
            <% } %>
          </div>
          <div class="pkg-card-footer">
            <a href="/admin/packages/<%= key %>/users" class="pkg-btn pkg-btn-outline">View Users</a>
          </div>
        </div>
      <% }); %>
    </div>

    <div class="pkg-two-col">
      <div class="pkg-table-section">
        <h2>All Packages</h2>
        <table class="pkg-table">
          <thead>
            <tr>
              <th>Package</th>
              <th>Price (Ksh)</th>
              <th>Referral %</th>
              <% if (typeof stats !== 'undefined' && stats) { %>
                <th>Active Users</th>
                <th>Revenue</th>
              <% } %>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% Object.entries(packages).forEach(([key, pkg]) => { %>
              <tr>
                <td>
                  <span class="pkg-table-name"><%= pkg.name %></span>
                  <span class="pkg-table-key"><%= key %></span>
                </td>
                <td><%= pkg.price?.toLocaleString() %></td>
                <td><%= ((pkg.referral || 0) * 100).toFixed(0) %>%</td>
                <% if (typeof stats !== 'undefined' && stats) { %>
                  <td><%= stats[key]?.activeUsers || 0 %></td>
                  <td>Ksh <%= (stats[key]?.revenue || 0).toLocaleString() %></td>
                <% } %>
                <td><a href="/admin/packages/<%= key %>/users" class="pkg-table-link">View users →</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <div class="pkg-table-section">
        <h2>Recent Package Activity</h2>
        <% if (typeof recentActivity !== 'undefined' && recentActivity && recentActivity.length > 0) { %>
          <ul class="pkg-activity-list">
            <% recentActivity.forEach((a) => { %>
              <li class="pkg-activity-item">
                <div>
                  <span class="pkg-activity-user"><%= a.name %></span>
                  <span class="pkg-activity-pkg"><%= a.packageName %> (<%= a.packageKey %>)</span>
                </div>
                <span class="pkg-activity-date">
                  <%= new Date(a.date).toLocaleDateString('en-KE', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </span>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <div class="pkg-empty">No recent activity.</div>
        <% } %>
      </div>
    </div>

  <% } %>

</div>