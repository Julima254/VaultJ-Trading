<%- include('../partials/adminHeader.ejs'); -%>


<main class="admin-dashboard">
    <div class="container py-5">
        <div class="row mb-4 align-items-center">
            <div class="col-md-8">
                <h1 class="fw-bold text-white">Vault<span class="text-gold">Coin</span> Terminal</h1>
                <p class="text-muted">System-wide market control and liquidity management.</p>
            </div>
            <div class="col-md-4">
                <div class="p-3 rounded border border-success" style="background: rgba(46, 204, 113, 0.1);">
                    <small class="text-muted d-block">Total Platform Revenue (Fees)</small>
                    <span class="fs-4 fw-bold text-green">KSh <%= revenueFromFees.toLocaleString() %></span>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card market-card mb-4 p-4 shadow">
                    <h5 class="fw-bold mb-3 text-gold">Liquidity Provider</h5>
                    <% if (liquidityUser) { %>
                        <div class="mb-3">
                            <small class="text-muted d-block">Active Account</small>
                            <span class="fw-bold text-white"><%= liquidityUser.username %></span>
                            <span class="badge bg-success ms-2">Active Provider</span>
                        </div>
                        
                        <div class="row g-2 mb-4">
                            <div class="col-6">
                                <div class="p-2 rounded bg-dark border border-secondary">
                                    <small class="text-muted d-block">Pool KSh</small>
                                    <span class="text-green fw-bold">KES <%= liquidityUser.walletBalance.toLocaleString() %></span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 rounded bg-dark border border-secondary">
                                    <small class="text-muted d-block">Pool VTC</small>
                                    <span class="text-gold fw-bold"><%= liquidityUser.coinsBalance.toFixed(2) %></span>
                                </div>
                            </div>
                        </div>

                        <form action="/admin/users/<%= liquidityUser._id %>/adjust-balance" method="POST" class="border-top border-secondary pt-3">
                            <label class="form-label small text-muted">Adjust Pool Balances (+/-)</label>
                            <div class="input-group input-group-sm mb-2">
                                <span class="input-group-text bg-dark text-muted border-secondary">KSh</span>
                                <input type="number" name="walletAmount" class="form-control bg-dark text-white border-secondary" placeholder="Amount">
                            </div>
                            <div class="input-group input-group-sm mb-3">
                                <span class="input-group-text bg-dark text-muted border-secondary">VTC</span>
                                <input type="number" name="coinAmount" class="form-control bg-dark text-white border-secondary" placeholder="Amount">
                            </div>
                            <button type="submit" class="btn btn-gold btn-sm w-100 fw-bold">UPDATE LIQUIDITY</button>
                        </form>
                    <% } else { %>
                        <div class="alert alert-danger">No liquidity provider set!</div>
                    <% } %>
                </div>

                <div class="card market-card p-4 shadow">
                    <h5 class="fw-bold mb-3 text-gold">Market Health</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Circulating Supply</span>
                        <span class="text-white small fw-bold"><%= coinsInCirculation.toFixed(2) %> VTC</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted small">Pending Buy/Sells</span>
                        <span class="text-white small fw-bold"><%= pendingOrders %></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted small">Market Floor Price</span>
                        <span class="text-gold small fw-bold">KSh <%= currentPrice.toLocaleString() %></span>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card market-card p-4 shadow h-100">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold m-0 text-gold">Recent Market Orders</h5>
                        <span class="badge bg-dark border border-secondary text-muted">Real-time Feed</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr class="text-muted small text-uppercase">
                                    <th>User</th>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>Price</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% recentOrders.forEach(order => { %>
                                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                                        <td class="text-white">
                                            <%= order.user ? order.user.username : 'System' %>
                                        </td>
                                        <td>
                                            <span class="<%= order.type === 'buy' ? 'text-green' : 'text-danger' %> fw-bold">
                                                <%= order.type.toUpperCase() %>
                                            </span>
                                        </td>
                                        <td class="text-white"><%= order.coinsAmount.toFixed(2) %></td>
                                        <td class="text-gold">KSh <%= order.price.toLocaleString() %></td>
                                        <td>
                                            <% if (order.status === 'completed') { %>
                                                <span class="badge bg-success-soft text-success border border-success px-2">Completed</span>
                                            <% } else { %>
                                                <span class="badge bg-warning-soft text-warning border border-warning px-2">Pending</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<style>
    :root {
        --dark-blue: #0a192f;
        --gold: #ffd700;
        --forest-green: #2ecc71;
        --card-bg: #112240;
    }

    body { background-color: var(--dark-blue); color: #e6f1ff; }

    /* Layout handling for the fixed sidebar */
    .admin-dashboard {
        padding: 1rem;
        transition: margin-left 0.3s ease;
    }

    /* Adjust these widths to match your adminSidebar.ejs exactly */
    @media (min-width: 768px) {
        .admin-dashboard {
            margin-left: 220px; 
            padding: 1.5rem 2rem;
        }
    }

    @media (min-width: 1024px) {
        .admin-dashboard {
            margin-left: 260px; 
            padding: 2rem 3rem;
        }
    }

    /* Component Styles */
    .market-card { background: var(--card-bg); border: 1px solid rgba(255, 215, 0, 0.1); border-radius: 15px; }
    .text-gold { color: var(--gold); }
    .text-green { color: var(--forest-green); }
    .btn-gold { background: var(--gold); color: var(--dark-blue); border: none; }
    .btn-gold:hover { background: #e6c300; color: var(--dark-blue); }
    
    .table { color: #b8c7e0; }
    .table thead th { border: none; }
    .table tbody tr td { border: none; padding: 12px 8px; }

    .bg-success-soft { background: rgba(46, 204, 113, 0.1); }
    .bg-warning-soft { background: rgba(255, 215, 0, 0.1); }
</style>