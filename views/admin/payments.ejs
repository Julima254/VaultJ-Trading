<%- include('../partials/adminHeader.ejs'); -%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Payments | Dashboard</title>
    <style>
        :root {
            --dark-blue: #0a192f;
            --light-navy: #112240;
            --gold: #ffcc00;
            --green: #2ecc71;
            --red: #e74c3c;
            --text-main: #e6f1ff;
            --text-dim: #8892b0;
            --sidebar-width: 260px; /* Adjust this to match your adminHeader width */
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--dark-blue);
            color: var(--text-main);
        }

        /* Layout for Sidebar */
        .admin-main {
            margin-left: var(--sidebar-width);
            padding: 20px;
            box-sizing: border-box;
        }

        @media (max-width: 992px) {
            .admin-main { margin-left: 0; }
        }

        /* THE FIX: Table Container with Fixed Height */
        .table-wrapper {
            background: var(--light-navy);
            border-radius: 12px;
            border: 1px solid #233554;
            
            /* This keeps the horizontal scrollbar visible on your screen at all times */
            max-height: calc(100vh - 250px); 
            overflow: auto; 
            
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            position: relative;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            /* Force the table to be wide so the scrollbar appears */
            min-width: 1300px; 
        }

        /* Sticky Header - So you see labels while scrolling down */
        thead th {
            position: sticky;
            top: 0;
            background: #1d3557;
            color: var(--gold);
            padding: 15px;
            z-index: 10;
            text-align: left;
            text-transform: uppercase;
            font-size: 0.8rem;
            border-bottom: 2px solid var(--gold);
        }

        td {
            padding: 12px 15px;
            border-bottom: 1px solid #233554;
            font-size: 0.9rem;
            white-space: nowrap; /* Prevents text wrapping so the scroll is smooth */
        }

        /* Custom Scrollbar Styling (So it looks good in Dark Blue/Gold) */
        .table-wrapper::-webkit-scrollbar {
            width: 10px;  /* Vertical */
            height: 10px; /* Horizontal - THIS IS THE ONE YOU WANT */
        }
        .table-wrapper::-webkit-scrollbar-track {
            background: var(--dark-blue);
        }
        .table-wrapper::-webkit-scrollbar-thumb {
            background: var(--gold);
            border-radius: 10px;
        }

        /* Form Styles */
        .filter-form {
            background: var(--light-navy);
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 20px;
        }
        .form-row { display: flex; gap: 15px; flex-wrap: wrap; margin-bottom: 10px; }
        .form-row label { display: flex; flex-direction: column; font-size: 0.8rem; color: var(--gold); }
        .form-row input, .form-row select { 
            background: var(--dark-blue); border: 1px solid #233554; color: white; padding: 8px; border-radius: 4px; 
        }

        .filter-btn {
            background: var(--gold); color: black; border: none; padding: 10px 20px; border-radius: 4px; font-weight: bold; cursor: pointer;
        }

        /* Status Colors */
        .pending { color: var(--gold); font-weight: bold; }
        .completed { color: var(--green); font-weight: bold; }
        .failed { color: var(--red); font-weight: bold; }

        .verify-btn { background: var(--green); color: white; border: none; padding: 5px 10px; border-radius: 3px; cursor: pointer; }
        .reject-btn { background: var(--red); color: white; border: none; padding: 5px 10px; border-radius: 3px; cursor: pointer; margin-left: 5px; }
    </style>
</head>
<body>

<main class="admin-main">
    <div class="container">
        <h1>Payments & Transactions</h1>

        <form class="filter-form" method="GET" action="/admin/payments">
            <div class="form-row">
                <label>From: <input type="date" name="from"></label>
                <label>To: <input type="date" name="to"></label>
                <label>Phone: <input type="text" name="phone"></label>
                <label>Amount: <input type="number" name="amount"></label>
                <label>Status: 
                    <select name="status">
                        <option value="">All</option>
                        <option value="pending">Pending</option>
                        <option value="completed">Completed</option>
                    </select>
                </label>
            </div>
            <button type="submit" class="filter-btn">Apply Filter</button>
        </form>

        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>User Details</th>
                        <th>Phone</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Mpesa Receipt</th>
                        <th>Request ID</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (payments.length === 0) { %>
                        <tr><td colspan="10">No transactions found</td></tr>
                    <% } %>
                    <% payments.forEach((p, index) => { %>
                        <tr>
                            <td><%= index + 1 %></td>
                            <td>
                                <strong><%= p.user ? p.user.username : 'N/A' %></strong><br>
                                <small><%= p.user ? p.user.email : '' %></small>
                            </td>
                            <td><%= p.phone || '-' %></td>
                            <td><%= p.type %></td>
                            <td style="font-weight: bold;">KES <%= p.amount %></td>
                            <td><span class="<%= p.status %>"><%= p.status %></span></td>
                            <td><code><%= p.code || 'None' %></code></td>
                            <td><small><%= p.checkoutRequestID || '-' %></small></td>
                            <td><%= p.createdAt.toLocaleString() %></td>
                            <td>
                                <% if (p.type === 'deposit' && p.status === 'pending') { %>
                                    <form method="POST" action="/admin/payments/verify/<%= p._id %>" style="display:inline;">
                                        <input type="text" name="receipt" placeholder="Code" style="width: 80px; background: #000; color: #fff; border: 1px solid var(--gold);">
                                        <button type="submit" class="verify-btn">Verify</button>
                                    </form>
                                    <form method="POST" action="/admin/payments/reject/<%= p._id %>" style="display:inline;">
                                        <button type="submit" class="reject-btn">Reject</button>
                                    </form>
                                <% } else { %>
                                    -
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</main>

</body>
</html>