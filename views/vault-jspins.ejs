<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Vault Jspins</title>
  <style>
    :root {
      --darkblue: #0B1F4D;
      --gold: #D4AF37;
      --green: #1E7B34;
      --lightgray: #D3D3D3;
    }

    body {
      background: var(--darkblue);
      color: var(--lightgray);
      font-family: Arial, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 30px;
    }

    h1 { color: var(--gold); }

    .balances {
      display: flex;
      gap: 30px;
      margin-bottom: 10px;
      font-size: 1.1rem;
    }

    .balances span { color: var(--gold); font-weight: bold; }

    .pool-warning {
      background: #4a1414;
      color: #ff9d9d;
      border: 1px solid #e05555;
      padding: 8px 16px;
      border-radius: 6px;
      margin-bottom: 16px;
      font-size: 0.95rem;
      display: none;
    }

    .pool-warning.show { display: block; }

    .wheel-wrap {
      position: relative;
      width: 320px;
      height: 320px;
      margin: 20px auto;
    }

    .pointer {
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      width: 0; height: 0;
      border-left: 14px solid transparent;
      border-right: 14px solid transparent;
      border-top: 22px solid var(--gold);
      z-index: 5;
    }

    .wheel {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      border: 6px solid var(--gold);
      position: relative;
      transition: transform 4s cubic-bezier(0.15, 0.7, 0.25, 1);
      background: conic-gradient(
        var(--darkblue)   0deg    51.43deg,
        var(--gold)        51.43deg 102.86deg,
        var(--green)       102.86deg 154.29deg,
        var(--lightgray)   154.29deg 205.71deg,
        var(--darkblue)    205.71deg 257.14deg,
        var(--gold)        257.14deg 308.57deg,
        var(--green)       308.57deg 360deg
      );
    }

    /* Zero-size wrapper pinned exactly at wheel center — rotating a
       point is always correct, unlike rotating an offset box. */
    .label-wrap {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
    }

    .label {
      position: absolute;
      left: 8px;
      top: -10px;
      width: 100px;
      text-align: right;
      padding-right: 10px;
      font-weight: bold;
      font-size: 0.95rem;
      color: #fff;
      white-space: nowrap;
    }

    .controls {
      margin-top: 30px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }

    input[type="number"] {
      padding: 8px 12px;
      border-radius: 6px;
      border: 2px solid var(--gold);
      background: #fff;
      color: var(--darkblue);
      width: 160px;
      font-size: 1rem;
      text-align: center;
    }

    button {
      background: var(--gold);
      color: var(--darkblue);
      border: none;
      padding: 10px 28px;
      font-weight: bold;
      border-radius: 6px;
      cursor: pointer;
      font-size: 1rem;
    }

    button:disabled { opacity: 0.5; cursor: not-allowed; }

    #result {
      margin-top: 16px;
      font-size: 1.2rem;
      min-height: 28px;
      color: var(--green);
      font-weight: bold;
    }

    #result.lose { color: #e05555; }
  </style>
</head>
<body>
    <%- include('partials/header') %>
  <h1>Vault Jspins</h1>

  <div class="balances">
    <div>Wallet: KSh <span id="walletBalance"><%= walletBalance.toFixed(2) %></span></div>
    
  </div>

  <div id="poolWarning" class="pool-warning">
    The game is temporarily unavailable. Please check back later.
  </div>

  <div class="wheel-wrap">
    <div class="pointer"></div>
    <div class="wheel" id="wheel">
      <div class="label-wrap" style="transform: rotate(25.71deg);"><div class="label">×0</div></div>
      <div class="label-wrap" style="transform: rotate(77.14deg);"><div class="label">×0.5</div></div>
      <div class="label-wrap" style="transform: rotate(128.57deg);"><div class="label">×1</div></div>
      <div class="label-wrap" style="transform: rotate(180deg);"><div class="label">×1.5</div></div>
      <div class="label-wrap" style="transform: rotate(231.43deg);"><div class="label">×2</div></div>
      <div class="label-wrap" style="transform: rotate(282.86deg);"><div class="label">×5</div></div>
      <div class="label-wrap" style="transform: rotate(334.29deg);"><div class="label">×10</div></div>
    </div>
  </div>

  <div class="controls">
    <input type="number" id="stakeInput" min="1" step="1" placeholder="Stake amount (KSh)" />
    <button id="spinBtn">Spin</button>
    <div id="result"></div>
  </div>

  <script>
    window.__initialPoolBalance = <%- poolBalance %>;
  </script>
  <script src="/js/vault-jspins.js"></script>
  <%- include('partials/footer') %>
</body>
</html>