    </ul>
  </nav>
</header>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const hamburgerBtn = document.getElementById("hamburgerBtn");
    const sideMenu = document.getElementById("sideMenu");
    const menuOverlay = document.getElementById("menuOverlay");
    const sideMenuClose = document.getElementById("sideMenuClose");

    function openMenu() {
      sideMenu.classList.add("open");
      menuOverlay.classList.add("active");
      sideMenu.setAttribute("aria-hidden", "false");
      hamburgerBtn.setAttribute("aria-expanded", "true");
    }

    function closeMenu() {
      sideMenu.classList.remove("open");
      menuOverlay.classList.remove("active");
      sideMenu.setAttribute("aria-hidden", "true");
      hamburgerBtn.setAttribute("aria-expanded", "false");
    }

    hamburgerBtn.addEventListener("click", openMenu);
    sideMenuClose.addEventListener("click", closeMenu);
    menuOverlay.addEventListener("click", closeMenu);
  });
</script>

<script>
  const referralCode = "<%= user.referralCode %>";
  const referralLink = window.location.origin + "/register?ref=" + encodeURIComponent(referralCode);
  const referralShareText = "Join me and start earning! Sign up here: " + referralLink;

  function shareReferralLink(event) {
    event.preventDefault();

    if (navigator.share) {
      navigator.share({
        title: "Join me!",
        text: "Join me and start earning!",
        url: referralLink,
      }).catch(function () {
        // user cancelled the share sheet — no action needed
      });
    } else {
      // Desktop / unsupported browsers: copy the link and let them know
      navigator.clipboard.writeText(referralLink).then(function () {
        alert("Referral link copied to clipboard:\n" + referralLink);
      }).catch(function () {
        prompt("Copy your referral link:", referralLink);
      });
    }
  }
</script>