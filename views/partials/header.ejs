<style>
  :root {
    --dark-blue: #0a1a3c;
    --dark-blue-light: #14295e;
    --gold: #d4af37;
    --gold-light: #e8cd6a;
    --green: #1b7340;
    --light-grey: #e9e9ec;
    --white: #ffffff;
    --header-height: 64px;
    --footer-height: 66px;
  }

  body {
    padding-top: var(--header-height);
    padding-bottom: var(--footer-height);
    background: var(--light-grey);
    font-family: 'Segoe UI', Arial, sans-serif;
    margin: 0;
  }

  /* ===== HEADER ===== */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    background: var(--dark-blue);
    box-shadow: 0 2px 8px rgba(0,0,0,0.25);
    z-index: 1000;
  }

  .header-inner {
    height: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
  }

  .header-logo img {
    height: 40px;
    display: block;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .badge-admin {
    background: var(--gold);
    color: var(--dark-blue);
    font-weight: 700;
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-decoration: none;
    display: inline-block;
    cursor: pointer;
    border: none;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .badge-admin:hover {
    background: var(--gold-light);
    transform: translateY(-1px);
  }

  .header-username {
    color: var(--white);
    font-weight: 600;
    font-size: 14px;
  }

  .status-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 12px;
    font-weight: 600;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .status-active {
    background: rgba(27, 115, 64, 0.2);
    color: var(--green);
  }
  .status-active .status-dot { background: var(--green); }

  .status-inactive {
    background: rgba(212, 175, 55, 0.15);
    color: var(--gold);
  }
  .status-inactive .status-dot { background: var(--gold); }

  .hamburger-btn {
    background: none;
    border: none;
    color: var(--gold);
    cursor: pointer;
    display: flex;
    align-items: center;
    padding: 4px;
  }

  /* ===== Slide-in side menu ===== */
  .menu-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease;
    z-index: 1001;
  }
  .menu-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .side-menu {
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    width: 280px;
    max-width: 85vw;
    background: var(--dark-blue-light);
    transform: translateX(100%);
    transition: transform 0.3s ease;
    z-index: 1002;
    display: flex;
    flex-direction: column;
    box-shadow: -4px 0 16px rgba(0,0,0,0.3);
  }
  .side-menu.open {
    transform: translateX(0);
  }

  .side-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px;
    color: var(--gold);
    font-weight: 700;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .side-menu-close {
    background: none;
    border: none;
    color: var(--white);
    font-size: 26px;
    cursor: pointer;
    line-height: 1;
  }

  .side-menu-list {
    list-style: none;
    margin: 0;
    padding: 8px 0;
  }

  .side-menu-list li a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 20px;
    color: var(--white);
    text-decoration: none;
    font-size: 15px;
    transition: background 0.2s ease;
  }

  .side-menu-list li a:hover {
    background: rgba(212, 175, 55, 0.12);
    color: var(--gold);
  }

  .side-menu-list li a svg {
    flex-shrink: 0;
    color: var(--gold);
  }

  .side-menu-divider {
    height: 1px;
    background: rgba(255,255,255,0.1);
    margin: 8px 20px;
  }

  .logout-link {
    color: #e57373 !important;
  }
  .logout-link svg { color: #e57373 !important; }

  /* ===== Responsive ===== */
  @media (min-width: 600px) and (max-width: 1024px) {
    .header-username { font-size: 15px; }
  }

  @media (min-width: 1025px) {
    .header-inner { padding: 0 32px; }
  }

  @media (max-width: 360px) {
    .header-username { display: none; }
  }
</style>

<header class="site-header">
  <div class="header-inner">

    <!-- Logo -->
    <a href="/dashboard" class="header-logo">
      <img src="/images/logo.png" alt="Logo" />
    </a>

    <!-- Right side: admin badge, username, status, hamburger -->
    <div class="header-right">

      <% if (user) { %>
        <% if (user.isAdmin) { %>
          <a href="/admin" class="badge-admin">Admin</a>
        <% } %>

        <span class="header-username"><%= user.username %></span>

        <span class="status-pill <%= user.isActive ? 'status-active' : 'status-inactive' %>">
          <span class="status-dot"></span>
          <%= user.isActive ? 'Active' : 'Not Active' %>
