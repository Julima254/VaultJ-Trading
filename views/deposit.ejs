<!DOCTYPE html>
<html lang="en" style="background:#0a1a3f;">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0a1a3f" />
  <meta name="color-scheme" content="dark" />
  <title>Deposit | VaultJ Trading</title>
  <style>
    :root {
      --dark-blue: #0a1a3f;
      --dark-blue-light: #12275c;
      --gold: #d4af37;
      --green: #2ecc71;
      --light-gray: #e6e6e6;
      --red: #e74c3c;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { background: var(--dark-blue); min-height: 100%; }
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      color: var(--light-gray);
      padding-bottom: 90px;
    }

    .deposit-wrap {
      max-width: 460px;
      margin: 24px auto;
      padding: 0 18px;
    }

    .card {
      background: var(--dark-blue-light);
      border: 1px solid rgba(212, 175, 55, 0.3);
      border-radius: 14px;
      padding: 22px;
      margin-bottom: 18px;
    }

    .card-title {
      color: var(--gold);
      font-size: 15px;
      font-weight: bold;
      margin-bottom: 16px;
      text-align: center;
    }

    label {
      display: block;
      font-size: 13px;
      color: var(--gold);
      margin-bottom: 6px;
    }

    input[type="text"], input[type="number"] {
      width: 100%;
      padding: 12px 14px;
      border-radius: 8px;
      border: 1px solid rgba(212, 175, 55, 0.3);
      background: rgba(255,255,255,0.04);
      color: var(--light-gray);
      font-size: 14px;
      margin-bottom: 16px;
    }

    input:focus { outline: none; border-color: var(--gold); }

    .btn {
      width: 100%;
      background: var(--gold);
      color: var(--dark-blue);
      border: none;
      padding: 13px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: bold;
      cursor: pointer;
    }

    .btn:disabled { opacity: 0.6; cursor: not-allowed; }

    .btn-outline {
      background: transparent;
      border: 1px solid var(--gold);
      color: var(--gold);
    }

    .fallback-link {
      display: block;
      text-align: center;
      color: var(--gold);
      font-size: 13px;
      text-decoration: underline;
      background: none;
      border: none;
      cursor: pointer;
      margin: 4px 0 20px;
      width: 100%;
    }

    .status-box {
      display: none;
      text-align: center;
      padding: 14px;
      border-radius: 10px;
      font-size: 13px;
      margin-top: 14px;
    }

    .status-box.pending { display: block; background: rgba(212,175,55,0.1); color: var(--gold); }
    .status-box.success { display: block; background: rgba(46,204,113,0.1); color: var(--green); }
    .status-box.failed { display: block; background: rgba(231,76,60,0.1); color: var(--red); }

    .spinner {
      display: inline-block;
      width: 14px;
      height: 14px;
      border: 2px solid rgba(212,175,55,0.3);
      border-top-color: var(--gold);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin-right: 8px;
      vertical-align: middle;
    }

    @keyframes spin { to { transform: rotate(360deg); } }

    .paybill-section { display: none; }

    .paybill-row {
      display: flex;
      justify-content: space-between;
      padding: 10px 0;
      border-bottom: 1px solid rgba(212,175,55,0.12);
      font-size: 13px;
    }
    .paybill-row:last-child { border-bottom: none; }
    .paybill-label { color: var(--gold); }
    .paybill-value { font-weight: bold; color: var(--light-gray); }

    .note {
      font-size: 12px;
      opacity: 0.7;
      text-align: center;
      margin-top: 12px;
      line-height: 1.5;
    }

    .divider {
      text-align: center;
      font-size: 12px;
      color: var(--gold);
      opacity: 0.6;
      margin: 18px 0;
    }
  </style>
</head>
<body>

  <%- include('partials/header') %>

  <div class="deposit-wrap">

    <!-- STK PUSH -->
    <div class="card">
      <div class="card-title">Deposit via M-Pesa</div>
      <form id="stkForm">
        <label for="phone">M-Pesa Phone Number</label>
        <input type="text" id="phone" name="phone" placeholder="07XXXXXXXX" required />

        <label for="amount">Amount (KES)</label>
        <input type="number" id="amount" name="amount" placeholder="e.g. 500" min="1" required />

        <button type="submit" class="btn" id="stkBtn">Pay with M-Pesa</button>
      </form>

      <div class="status-box" id="statusBox"></div>
    </div>

    <!-- Always-visible fallback link -->
    <button type="button" class="fallback-link" id="showPaybillBtn">
      Prompt not received? Use Paybill instead
    </button>

    <!-- PAYBILL INSTRUCTIONS + MANUAL SUBMISSION (toggled) -->
    <div id="paybillSection" class="paybill-section">

      <div class="card">
        <div class="card-title">Pay via Paybill</div>
        <div class="paybill-row">
          <span class="paybill-label">Paybill Number</span>
          <span class="paybill-value"><%= paybillNumber %></span>
        </div>
        <div class="paybill-row">
          <span class="paybill-label">Account Number</span>
          <span class="paybill-value"><%= paybillInstructions %></span>
        </div>
        <div class="note">
          Go to M-Pesa → Lipa na M-Pesa → Paybill on your phone and complete the payment using the details above.
        </div>
      </div>

      <div class="divider">— then confirm your payment below —</div>

      <div class="card">
        <div class="card-title">Confirm Manual Payment</div>
        <form id="manualForm">
          <label for="mpesaCode">M-Pesa Code</label>
          <input type="text" id="mpesaCode" name="code" placeholder="e.g. QCD7XXXXXX" required />

          <label for="manualAmount">Amount Paid (KES)</label>
          <input type="number" id="manualAmount" name="amount" placeholder="e.g. 500" min="1" required />

          <button type="submit" class="btn btn-outline" id="manualBtn">Submit for Review</button>
        </form>

        <div class="status-box" id="manualStatusBox"></div>
        <div class="note">Manual payments are reviewed by an admin and usually confirmed within a short time.</div>
      </div>

    </div>

  </div>

  <%- include('partials/footer') %>

  <script>
    const stkForm = document.getElementById('stkForm');
    const stkBtn = document.getElementById('stkBtn');
    const statusBox = document.getElementById('statusBox');
    const paybillSection = document.getElementById('paybillSection');
    const showPaybillBtn = document.getElementById('showPaybillBtn');
    let pollTimer = null;

    function setStatus(box, type, html) {
      box.className = 'status-box ' + type;
      box.innerHTML = html;
    }

    function showPaybillFallback() {
      paybillSection.style.display = 'block';
      paybillSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Manual toggle — visible from the start, not just after a failure
    showPaybillBtn.addEventListener('click', () => {
      const isOpen = paybillSection.style.display === 'block';
      paybillSection.style.display = isOpen ? 'none' : 'block';
      if (!isOpen) paybillSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    stkForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearInterval(pollTimer);
      stkBtn.disabled = true;

      const phone = document.getElementById('phone').value;
      const amount = document.getElementById('amount').value;

      setStatus(statusBox, 'pending', '<span class="spinner"></span>Sending M-Pesa prompt...');

      try {
        const res = await fetch('/deposit/stk', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ phone, amount }),
        });
        const data = await res.json();

        if (!data.success) {
          setStatus(statusBox, 'failed', data.message || 'Payment could not be started.');
          if (data.fallbackToPaybill) showPaybillFallback();
          stkBtn.disabled = false;
          return;
        }

        setStatus(statusBox, 'pending', '<span class="spinner"></span>Enter your M-Pesa PIN on your phone to complete payment...');
        pollStatus(data.checkoutRequestId);
      } catch (err) {
        setStatus(statusBox, 'failed', 'Unable to reach M-Pesa right now.');
        showPaybillFallback();
        stkBtn.disabled = false;
      }
    });

    function pollStatus(checkoutRequestId) {
      let attempts = 0;
      const maxAttempts = 20; // ~60s at 3s intervals

      pollTimer = setInterval(async () => {
        attempts++;
        try {
          const res = await fetch(`/deposit/status/${checkoutRequestId}`);
          const data = await res.json();

          if (data.status === 'completed') {
            clearInterval(pollTimer);
            setStatus(statusBox, 'success', `Payment received! Ref: ${data.code}. Your wallet has been credited.`);
            stkBtn.disabled = false;
          } else if (data.status === 'failed') {
            clearInterval(pollTimer);
            setStatus(statusBox, 'failed', 'Payment was not completed or was cancelled.');
            showPaybillFallback();
            stkBtn.disabled = false;
          } else if (attempts >= maxAttempts) {
            clearInterval(pollTimer);
            setStatus(statusBox, 'failed', 'No response received. If you already paid, it may still be processing.');
            showPaybillFallback();
            stkBtn.disabled = false;
          }
        } catch (err) {
          // keep polling silently on transient network errors
        }
      }, 3000);
    }

    // Manual submission
    const manualForm = document.getElementById('manualForm');
    const manualBtn = document.getElementById('manualBtn');
    const manualStatusBox = document.getElementById('manualStatusBox');

    manualForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      manualBtn.disabled = true;

      const code = document.getElementById('mpesaCode').value;
      const amount = document.getElementById('manualAmount').value;

      setStatus(manualStatusBox, 'pending', '<span class="spinner"></span>Submitting...');

      try {
        const res = await fetch('/deposit/manual', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code, amount }),
        });
        const data = await res.json();

        if (data.success) {
          setStatus(manualStatusBox, 'success', data.message);
          manualForm.reset();
        } else {
          setStatus(manualStatusBox, 'failed', data.message || 'Submission failed.');
          manualBtn.disabled = false;
        }
      } catch (err) {
        setStatus(manualStatusBox, 'failed', 'Unable to submit right now. Please try again.');
        manualBtn.disabled = false;
      }
    });
  </script>

</body>
</html>