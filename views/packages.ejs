<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Packages</title>
  <style>
    * {
      box-sizing: border-box;
    }
    body {
      background: #f0f0f0; /* light grey */
      font-family: Arial, Helvetica, sans-serif;
      margin: 0;
      padding: 0;
    }
    .header {
      background: #0a1f44; /* dark blue */
      color: #fff;
      padding: 25px 20px;
      text-align: center;
    }
    .header h1 {
      margin: 0;
      color: #ffd700; /* gold */
      font-size: 26px;
    }
    .status-banner {
      max-width: 900px;
      margin: 20px auto 0;
      padding: 12px 18px;
      border-radius: 6px;
      font-weight: bold;
    }
    .status-error {
      background: #ffe0e0;
      color: #a10000;
      border: 1px solid #a10000;
    }
    .status-success {
      background: #e3f8e6;
      color: #1a7a2e; /* green */
      border: 1px solid #1a7a2e;
    }
    .current-package {
      max-width: 900px;
      margin: 20px auto;
      background: #fff;
      border-left: 6px solid #0a1f44;
      padding: 15px 20px;
      border-radius: 6px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.1);
    }
    .current-package span {
      color: #ffd700;
      background: #0a1f44;
      padding: 2px 10px;
      border-radius: 4px;
      font-weight: bold;
      display: inline-block;
    }
    .grid {
      max-width: 1100px;
      margin: 30px auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 24px;
      padding: 0 20px;
    }

    /* --- Base card --- */
    .card {
      position: relative;
      background: #ffffff;
      border-radius: 14px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .card:hover {
      transform: translateY(-6px);
    }

    .card-header {
      text-align: center;
      padding: 22px 10px 14px;
      position: relative;
    }
    .icon {
      font-size: 34px;
      display: block;
      margin-bottom: 8px;
      filter: drop-shadow(0 0 6px rgba(255,255,255,0.6));
    }
    .card-header h2 {
      margin: 0;
      font-size: 20px;
      letter-spacing: 1px;
      color: #fff;
      text-shadow: 0 1px 3px rgba(0,0,0,0.3);
    }
    .card-body {
      padding: 20px;
      text-align: center;
      flex-grow: 1;
      background: #fdfdfd;
    }
    .price {
      font-size: 28px;
      font-weight: bold;
      color: #0a1f44;
      margin: 10px 0;
    }
    .referral {
      font-weight: bold;
      margin-bottom: 15px;
      color: #1a7a2e;
    }
    .buy-btn {
      display: block;
      width: 100%;
      padding: 14px;
      border: none;
      font-weight: bold;
      font-size: 15px;
      cursor: pointer;
      color: #fff;
      letter-spacing: 0.5px;
      transition: filter 0.2s ease;
    }
    .buy-btn:hover {
      filter: brightness(1.1);
    }
    .active-badge {
      display: block;
      text-align: center;
      padding: 12px;
      background: #1a7a2e;
      color: #fff;
      font-weight: bold;
    }

    /* --- Themed color cycles (4 tiers, repeats if more packages) --- */

    /* Tier 1 — Bronze */
    .card:nth-child(4n+1) {
      border: 1px solid #cd8a4f;
      box-shadow: 0 0 18px rgba(205, 138, 79, 0.35);
    }
    .card:nth-child(4n+1):hover {
      box-shadow: 0 0 30px rgba(205, 138, 79, 0.65);
    }
    .card:nth-child(4n+1) .card-header {
      background: linear-gradient(135deg, #a9642f, #cd8a4f);
    }
    .card:nth-child(4n+1) .buy-btn {
      background: #cd8a4f;
    }
    .card:nth-child(4n+1) .referral { color: #a9642f; }

    /* Tier 2 — Silver */
    .card:nth-child(4n+2) {
      border: 1px solid #9aa5b1;
      box-shadow: 0 0 18px rgba(154, 165, 177, 0.4);
    }
    .card:nth-child(4n+2):hover {
      box-shadow: 0 0 30px rgba(154, 165, 177, 0.7);
    }
    .card:nth-child(4n+2) .card-header {
      background: linear-gradient(135deg, #6b7280, #9aa5b1);
    }
    .card:nth-child(4n+2) .buy-btn {
      background: #6b7280;
    }
    .card:nth-child(4n+2) .referral { color: #4b5563; }

    /* Tier 3 — Gold */
    .card:nth-child(4n+3) {
      border: 1px solid #ffd700;
      box-shadow: 0 0 20px rgba(255, 215, 0, 0.45);
    }
    .card:nth-child(4n+3):hover {
      box-shadow: 0 0 34px rgba(255, 215, 0, 0.8);
    }
    .card:nth-child(4n+3) .card-header {
      background: linear-gradient(135deg, #b8860b, #ffd700);
    }
    .card:nth-child(4n+3) .card-header h2 {
      color: #0a1f44;
      text-shadow: none;
    }
    .card:nth-child(4n+3) .buy-btn {
      background: #ffd700;
      color: #0a1f44;
    }
    .card:nth-child(4n+3) .referral { color: #b8860b; }

    /* Tier 4 — Platinum / Diamond */
    .card:nth-child(4n+4) {
      border: 1px solid #00c9d1;
      box-shadow: 0 0 20px rgba(0, 201, 209, 0.45);
    }
    .card:nth-child(4n+4):hover {
      box-shadow: 0 0 34px rgba(0, 201, 209, 0.8);
    }
    .card:nth-child(4n+4) .card-header {
      background: linear-gradient(135deg, #0a1f44, #00c9d1);
    }
    .card:nth-child(4n+4) .buy-btn {
      background: #00c9d1;
    }
    .card:nth-child(4n+4) .referral { color: #0891a3; }

    /* Icons per tier (using unicode, no external assets needed) */
    .card:nth-child(4n+1) .icon::before { content: "🥉"; }
    .card:nth-child(4n+2) .icon::before { content: "🥈"; }
    .card:nth-child(4n+3) .icon::before { content: "🥇"; }
    .card:nth-child(4n+4) .icon::before { content: "💎"; }

    /* Active package glow pulse */
    .card.is-active {
      animation: pulseGlow 2s ease-in-out infinite;
    }
    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 18px rgba(26, 122, 46, 0.4); }
      50% { box-shadow: 0 0 30px rgba(26, 122, 46, 0.8); }
    }

    /* --- Confirmation modal --- */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(10, 31, 68, 0.6);
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 15px;
    }
    .modal-overlay.open {
      display: flex;
    }
    .modal-box {
      background: #fff;
      border-radius: 12px;
      width: 100%;
      max-width: 400px;
      overflow: hidden;
      box-shadow: 0 10px 40px rgba(0,0,0,0.3);
      animation: modalPop 0.2s ease;
    }
    @keyframes modalPop {
      from { transform: scale(0.92); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
    .modal-header {
      background: #0a1f44;
      color: #ffd700;
      padding: 18px 20px;
      font-size: 18px;
      font-weight: bold;
    }
    .modal-body {
      padding: 20px;
      text-align: center;
      color: #333;
      line-height: 1.6;
    }
    .modal-body .modal-pkg-name {
      color: #0a1f44;
      font-weight: bold;
      font-size: 18px;
    }
    .modal-body .modal-pkg-price {
      color: #1a7a2e;
      font-weight: bold;
      font-size: 20px;
    }
    .modal-actions {
      display: flex;
      border-top: 1px solid #eee;
    }
    .modal-actions button {
      flex: 1;
      padding: 14px;
      border: none;
      font-weight: bold;
      font-size: 15px;
      cursor: pointer;
    }
    .modal-cancel {
      background: #f0f0f0;
      color: #333;
    }
    .modal-cancel:hover {
      background: #e2e2e2;
    }
    .modal-confirm {
      background: #1a7a2e;
      color: #fff;
    }
    .modal-confirm:hover {
      filter: brightness(1.1);
    }

    /* --- Mobile responsiveness --- */
    @media (max-width: 600px) {
      .header {
        padding: 20px 15px;
      }
      .header h1 {
        font-size: 22px;
      }
      .status-banner {
        margin: 15px 15px 0;
        font-size: 14px;
      }
      .current-package {
        margin: 15px;
        padding: 15px;
        font-size: 14px;
        line-height: 1.6;
      }
      .current-package br {
        display: none;
      }
      .current-package span {
        margin: 4px 0;
      }
      .grid {
        grid-template-columns: 1fr;
        padding: 0 15px;
        gap: 18px;
        margin: 20px auto;
      }
      .card-header {
        padding: 18px 10px 12px;
      }
      .card-header h2 {
        font-size: 18px;
      }
      .icon {
        font-size: 30px;
      }
      .price {
        font-size: 24px;
      }
      .buy-btn {
        padding: 14px;
        font-size: 16px;
      }
    }

    @media (max-width: 360px) {
      .header h1 {
        font-size: 20px;
      }
      .price {
        font-size: 22px;
      }
      .current-package {
        font-size: 13px;
      }
    }
  </style>
</head>
<body>
    <%- include('partials/header') %>

  <div class="header">
    <h1>Choose Your Package</h1>
  </div>

  <% if (error) { %>
    <div class="status-banner status-error"><%= error %></div>
  <% } %>
  <% if (success) { %>
    <div class="status-banner status-success"><%= success %></div>
  <% } %>

  <div class="current-package">
    Current package: <span><%= user.package %></span>
    &nbsp;|&nbsp; Status:
    <span style="background:<%= user.isActive ? '#1a7a2e' : '#a10000' %>">
      <%= user.isActive ? 'Active' : 'Inactive' %>
    </span>
    <br><br>
    Deposit Balance: <strong>Ksh <%= user.depositBalance %></strong>
    &nbsp;|&nbsp;
    Wallet Balance: <strong>Ksh <%= user.walletBalance %></strong>
  </div>

  <div class="grid">
    <% Object.keys(packages).forEach(key => { const pkg = packages[key]; const isCurrent = user.package === pkg.name && user.isActive; %>
      <div class="card<%= isCurrent ? ' is-active' : '' %>">
        <div class="card-header">
          <span class="icon"></span>
          <h2><%= pkg.name %></h2>
        </div>
        <div class="card-body">
          <div class="price">Ksh <%= pkg.price %></div>
          <div class="referral"><%= pkg.referral * 100 %>% Referral Earning</div>
        </div>
        <% if (isCurrent) { %>
          <div class="active-badge">✓ Current Package</div>
        <% } else { %>
          <button
            type="button"
            class="buy-btn"
            onclick="openBuyModal('<%= key %>', '<%= pkg.name %>', '<%= pkg.price %>')"
          >
            Buy Now
          </button>
        <% } %>
      </div>
    <% }) %>
  </div>

  <!-- Confirmation Modal -->
  <div class="modal-overlay" id="buyModalOverlay">
    <div class="modal-box">
      <div class="modal-header">Confirm Purchase</div>
      <div class="modal-body">
        Are you sure you want to purchase the
        <div class="modal-pkg-name" id="modalPkgName"></div>
        package for
        <div class="modal-pkg-price" id="modalPkgPrice"></div>
        ?
      </div>
      <div class="modal-actions">
        <button type="button" class="modal-cancel" onclick="closeBuyModal()">Cancel</button>
        <button type="button" class="modal-confirm" onclick="confirmBuy()">Yes, Buy</button>
      </div>
    </div>
  </div>

  <form id="buyForm" action="/packages/buy" method="POST" style="display:none;">
    <input type="hidden" name="packageKey" id="buyFormPackageKey" value="">
  </form>

  <script>
    function openBuyModal(key, name, price) {
      document.getElementById('modalPkgName').textContent = name;
      document.getElementById('modalPkgPrice').textContent = 'Ksh ' + price;
      document.getElementById('buyFormPackageKey').value = key;
      document.getElementById('buyModalOverlay').classList.add('open');
    }

    function closeBuyModal() {
      document.getElementById('buyModalOverlay').classList.remove('open');
    }

    function confirmBuy() {
      document.getElementById('buyForm').submit();
    }

    // Close modal when clicking outside the box
    document.getElementById('buyModalOverlay').addEventListener('click', function (e) {
      if (e.target === this) {
        closeBuyModal();
      }
    });
  </script>

<%- include('partials/footer') %>
</body>
</html>