<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Access Denied</title>
  <style>
    body {
      margin: 0;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0a1a3c; /* darkblue */
      color: #f5f5f5; /* lightgray */
      font-family: Arial, sans-serif;
      text-align: center;
    }
    .box h1 {
      color: #d4af37; /* gold */
      font-size: 3rem;
      margin-bottom: 10px;
    }
    .box a {
      color: #2e8b57; /* green */
      text-decoration: none;
      font-weight: bold;
    }
    .box a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <div class="box">
    <h1>error 403</h1>
    <p>You don't have permission to access this page.</p>
    <a href="/">Go back home</a>
  </div>
</body>
</html>