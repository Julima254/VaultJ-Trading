<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Login - VaultJ Trading</title>
<style>
:root {
  --dark-blue: #0a1930;
  --dark-blue-2: #112645;
  --panel: #14294a;
  --gold: #d4af37;
  --gold-hover: #e6c453;
  --green: #1fa971;
  --light-grey: #d6dae1;
  --muted-grey: #8f9aad;
  --border: #23385c;
  --error: #ff6b6b;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  background: linear-gradient(160deg, var(--dark-blue) 0%, #081222 100%);
  color: var(--light-grey);
  font-family: 'Segoe UI', Arial, sans-serif;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}
.auth-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 40px 36px;
  width: 100%;
  max-width: 420px;
  box-shadow: 0 12px 40px rgba(0,0,0,0.45);
}
.brand { text-align: center; margin-bottom: 28px; }
.brand h1 { color: var(--gold); font-size: 26px; letter-spacing: 1px; }
.brand span { color: var(--green); }
.brand p { color: var(--muted-grey); font-size: 13px; margin-top: 4px; }
h2.form-title { color: var(--light-grey); font-size: 19px; margin-bottom: 20px; font-weight: 600; }
.form-group { margin-bottom: 16px; }
.form-group label { display: block; font-size: 13px; color: var(--muted-grey); margin-bottom: 6px; }
.form-group input {
  width: 100%;
  padding: 12px 14px;
  background: var(--dark-blue-2);
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--light-grey);
  font-size: 14px;
  outline: none;
  transition: border-color 0.2s;
}
.form-group input:focus { border-color: var(--gold); }
.form-group input::placeholder { color: #5c6a80; }
.btn-primary {
  width: 100%;
  padding: 13px;
  background: var(--gold);
  color: var(--dark-blue);
  border: none;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  margin-top: 8px;
  transition: background 0.2s;
}
.btn-primary:hover { background: var(--gold-hover); }
.forgot-link { text-align: right; margin-top: -8px; margin-bottom: 16px; }
.forgot-link a { color: var(--green); font-size: 12.5px; text-decoration: none; }
.forgot-link a:hover { text-decoration: underline; }
.form-footer { text-align: center; margin-top: 20px; font-size: 13px; color: var(--muted-grey); }
.form-footer a { color: var(--gold); text-decoration: none; font-weight: 600; }
.form-footer a:hover { text-decoration: underline; }
.error-msg {
  background: rgba(255,107,107,0.1);
  border: 1px solid var(--error);
  color: var(--error);
  padding: 10px 14px;
  border-radius: 6px;
  font-size: 13px;
  margin-bottom: 16px;
}
.success-msg {
  background: rgba(31,169,113,0.1);
  border: 1px solid var(--green);
  color: var(--green);
  padding: 10px 14px;
  border-radius: 6px;
  font-size: 13px;
  margin-bottom: 16px;
}
</style>
</head>
<body>
  <div class="auth-card">
    <div class="brand">
      <h1>Vault<span>J</span> Trading</h1>
      <p>Log in to your account</p>
    </div>

    <h2 class="form-title">Login</h2>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="success-msg"><%= success %></div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-msg"><%= error %></div>
    <% } %>

    <form action="/login" method="POST">
      <div class="form-group">
        <label for="identifier">Username or Email</label>
        <input type="text" id="identifier" name="identifier" placeholder="Enter username or email" required>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Enter your password" required>
      </div>

      <div class="forgot-link">
        <a href="/forgot-password">Forgot Password?</a>
      </div>

      <button type="submit" class="btn-primary">Log In</button>
    </form>

    <div class="form-footer">
      Don't have an account? <a href="/register">Register</a>
    </div>
  </div>
</body>
</html>
